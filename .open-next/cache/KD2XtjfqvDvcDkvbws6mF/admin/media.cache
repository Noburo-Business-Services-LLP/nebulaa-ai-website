{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/admin/layout,_N_T_/admin/media/layout,_N_T_/admin/media/page,_N_T_/admin/media"}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/91d486bf57bf1762.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-03f7c6bc932ce1e3.js\"/><script src=\"/_next/static/chunks/fd9d1056-b11b2651f33aae7f.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-4f5b424f20efdcae.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-6cdff17d3be181bf.js\" async=\"\"></script><script src=\"/_next/static/chunks/972-8c0ee6fabcd1342f.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/admin/media/page-18dd953c065cc49f.js\" async=\"\"></script><script src=\"/_next/static/chunks/309-526a3bc2ba734d25.js\" async=\"\"></script><script src=\"/_next/static/chunks/878-ed980f2cac33ad8c.js\" async=\"\"></script><script src=\"/_next/static/chunks/739-3ece649a7e02ff75.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-5a72189eaa6243d0.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>Media slots — Nebulaa admin | Nebulaa.ai</title><meta name=\"description\" content=\"Two AI agents. Your entire GTM. Automated. Gravity posts, Pulsar calls. Built for Indian founders and SMBs. Start free — 100 credits, no card.\"/><meta name=\"keywords\" content=\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\"/><meta name=\"robots\" content=\"noindex, nofollow\"/><link rel=\"canonical\" href=\"https://nebulaa.ai\"/><meta property=\"og:title\" content=\"Nebulaa.ai — Your GTM Team Just Showed Up\"/><meta property=\"og:description\" content=\"Gravity posts. Pulsar calls. You close.\"/><meta property=\"og:url\" content=\"https://nebulaa.ai\"/><meta property=\"og:site_name\" content=\"Nebulaa.ai\"/><meta property=\"og:locale\" content=\"en_IN\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@nebulaaai\"/><meta name=\"twitter:title\" content=\"Nebulaa.ai — AI Marketing &amp; Outreach for Founders\"/><meta name=\"twitter:description\" content=\"Two AI agents. Your entire GTM. Automated.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&amp;family=Inter:wght@300;400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap\" rel=\"stylesheet\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"legalName\":\"Noburo Business Services LLP\",\"url\":\"https://nebulaa.ai\",\"email\":\"hello@nebulaa.ai\",\"description\":\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\",\"foundingDate\":\"2025\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressRegion\":\"Tamil Nadu\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"},\"makesOffer\":[{\"@type\":\"Offer\",\"name\":\"Gravity\",\"price\":\"10000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Gravity\",\"description\":\"Reads a website and builds a marketing strategy from it, plans the month, drafts posts, carousels and reels, tracks competitors, runs campaigns and creator collaborations, and handles the social inbox.\"}},{\"@type\":\"Offer\",\"name\":\"Pulsar\",\"price\":\"15000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Pulsar\",\"description\":\"Answers enquiries on WhatsApp, email and SMS within minutes, qualifies budget, timeline and fit, scores every lead, and runs broadcasts, automation and voice calling.\"}},{\"@type\":\"Offer\",\"name\":\"Both agents\",\"price\":\"20000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Both agents\",\"description\":\"Gravity and Pulsar on one account, sharing the same brand memory.\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"bg-ground text-ink font-body antialiased\"><main class=\"bg-ground text-ink min-h-screen px-6 md:px-12 lg:px-[80px] py-[70px]\"><a class=\"inline-flex items-center gap-1.5 text-[13px] text-muted hover:text-ink mb-8\" href=\"/admin\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg> Admin</a><span class=\"neb-label neb-label-gold mb-[22px] block\">Media slots</span><h1 class=\"font-heading font-medium text-[34px] md:text-[46px] leading-[1.1] tracking-[-0.02em] mb-4\">0<!-- --> of <!-- -->24<!-- --> slots filled.</h1><p class=\"text-[16px] leading-[1.65] text-muted max-w-[68ch] mb-3\">Drop a file into <code class=\"text-ink-2\">public/media/</code> using the exact filename below and it appears everywhere that slot is used — no code change. Then run<!-- --> <code class=\"text-ink-2\">npm run media:scan</code>, or just deploy; it runs on every build.</p><p class=\"text-[14px] leading-[1.6] text-faint max-w-[68ch] mb-[52px]\">Empty slots render a labelled placeholder on the live site rather than a blank box, so an outstanding asset always reads as a known gap.</p><div class=\"flex flex-col gap-12\"><section><h2 class=\"font-heading font-medium text-[24px] mb-1.5\">Product screenshots</h2><p class=\"text-[14px] text-muted mb-6 max-w-[70ch]\">Captured from the Gravity and Pulsar apps at 2x.</p><div class=\"flex flex-col gap-3\"><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — content calendar</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">Month view with scheduled posts and their thumbnails visible. The strongest single proof that Gravity plans a month rather than a post.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-calendar.png</code></span><span>2880×1800 (1440×900 @2x)</span><span>Used on <!-- -->Homepage Gravity section, /product/gravity/content-planning</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — post approval</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">A drafted post with the Approve / Rewrite controls showing. Backs the &quot;nothing publishes until you tap approve&quot; claim.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-approval.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/gravity/approvals, narrative demo</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — strategy output</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">What Gravity produces after reading a URL: tone, ICP, competitors, channel plan. This is the hero promise, evidenced.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-strategy.png</code></span><span>2880×1800</span><span>Used on <!-- -->Hero, /product/gravity/strategy-icp</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — campaign builder</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">The campaign view. Currently unmarketed entirely — no page mentions campaigns exist.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-campaigns.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/gravity/campaigns</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — reel generator</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">Reel generation in progress or a finished reel with its scenes.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-reels.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/gravity/reels, /channels/reels-shorts</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — unified inbox</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">Comments, DMs and replies in one view, ideally with auto-reply settings visible.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-inbox.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/gravity/unified-inbox</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — influencer portal</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">Creator list, collaborations or submission review. An entire shipped module with no page on the site today.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-influencers.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/gravity/influencers, /services/influencer-marketing</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — competitor tracking</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">Rivals being tracked, ideally alongside the counter-content drafted from them.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-competitors.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/gravity/competitors</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gravity — analytics</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">Performance dashboard. Redact or swap client names if any are visible.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">gravity-analytics.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/gravity/analytics, /services/reporting</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Pulsar — WhatsApp conversation</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">A real qualified conversation, phone-framed, names and numbers redacted. Highest-value asset on this list — WhatsApp is the biggest differentiator and it is currently drawn with hand-built bubbles.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">pulsar-whatsapp.png</code></span><span>1290×2796 (phone @3x)</span><span>Used on <!-- -->Homepage Pulsar section, /channels/whatsapp</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Pulsar — lead list with scores</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">Leads with scores and statuses, enough rows to show real volume.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">pulsar-leads.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/pulsar/leads</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Pulsar — broadcast composer</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">Composing a broadcast with the audience selected.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">pulsar-broadcasts.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/pulsar/broadcasts</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Pulsar — call queue</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">The voice calling queue. Confirmed shippable but effectively hidden on the site.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">pulsar-callqueue.png</code></span><span>2880×1800</span><span>Used on <!-- -->/product/pulsar/voice-calling</span></div></div></div></section><section><h2 class=\"font-heading font-medium text-[24px] mb-1.5\">Client logos</h2><p class=\"text-[14px] text-muted mb-6 max-w-[70ch]\">SVG preferred. Each needs display permission before it goes live.</p><div class=\"flex flex-col gap-3\"><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Gandhimathi Jewellers logo</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">SVG preferred, else 512px PNG on transparent. Needs display permission.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">logo-gandhimathi.svg</code></span><span>SVG or 512px</span><span>Used on <!-- -->Client strip, /for/jewellery-retail</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">JKR Tex logo</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">SVG preferred, else 512px PNG on transparent.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">logo-jkrtex.svg</code></span><span>SVG or 512px</span><span>Used on <!-- -->Client strip, /for/textile-apparel</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">TNV Chits logo</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">SVG preferred, else 512px PNG on transparent.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">logo-tnvchits.svg</code></span><span>SVG or 512px</span><span>Used on <!-- -->Client strip, /for/financial-services</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Rajaram&#x27;s logo</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">SVG preferred, else 512px PNG on transparent.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">logo-rajarams.svg</code></span><span>SVG or 512px</span><span>Used on <!-- -->Client strip, /for/fmcg-food</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Nellai Kuttam Snacks logo</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">SVG preferred, else 512px PNG on transparent.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">logo-nellaikuttam.svg</code></span><span>SVG or 512px</span><span>Used on <!-- -->Client strip, /for/fmcg-food</span></div></div></div></section><section><h2 class=\"font-heading font-medium text-[24px] mb-1.5\">Sample creative</h2><p class=\"text-[14px] text-muted mb-6 max-w-[70ch]\">Illustrative of what Gravity produces — never captioned as a named client’s published work.</p><div class=\"flex flex-col gap-3\"><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Sample creative — jewellery</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">A social post in the style Gravity produces for a jewellery brand. Illustrative, never captioned as a named client’s published work.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">creative-jewellery.jpg</code></span><span>1080×1080</span><span>Used on <!-- -->/for/jewellery-retail, proof gallery</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Sample creative — textile</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">A social post in the style Gravity produces for a textile retailer.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">creative-textile.jpg</code></span><span>1080×1080</span><span>Used on <!-- -->/for/textile-apparel, proof gallery</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Sample creative — FMCG / snacks</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">A social post in the style Gravity produces for a food brand.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">creative-fmcg.jpg</code></span><span>1080×1080</span><span>Used on <!-- -->/for/fmcg-food, proof gallery</span></div></div></div></section><section><h2 class=\"font-heading font-medium text-[24px] mb-1.5\">Activation photography</h2><p class=\"text-[14px] text-muted mb-6 max-w-[70ch]\">Documentary realism, Indian tier-2 retail.</p><div class=\"flex flex-col gap-3\"><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">BTL — sampling drive</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">A sampling table in a store aisle. Documentary realism, Indian tier-2 retail, natural light — not stock-photo gloss. Our most defensible service has no visual anywhere on the site.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">btl-sampling.jpg</code></span><span>2400×1600</span><span>Used on <!-- -->/services/btl-activation, /services</span></div></div><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">BTL — in-store demo</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">A promoter-led product demo in-store.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">btl-instore.jpg</code></span><span>2400×1600</span><span>Used on <!-- -->/services/btl-activation</span></div></div></div></section><section><h2 class=\"font-heading font-medium text-[24px] mb-1.5\">Video</h2><p class=\"text-[14px] text-muted mb-6 max-w-[70ch]\">Autoplayed muted in a phone frame. Keep under 8MB.</p><div class=\"flex flex-col gap-3\"><div class=\"rounded-[14px] border p-5 border-rule bg-surface\"><div class=\"flex flex-wrap items-center gap-3 mb-2\"><span class=\"text-[11px] font-semibold uppercase tracking-[0.08em] text-faint\">awaiting</span><span class=\"font-heading text-[17px]\">Sample reel</span></div><p class=\"text-[14px] leading-[1.6] text-muted mb-3 max-w-[74ch]\">A reel produced through Gravity, for autoplay muted in a phone frame. &quot;Posts, carousels and AI reels&quot; is currently a claim with no evidence. Keep under 8MB.</p><div class=\"flex flex-wrap gap-x-6 gap-y-1 text-[12.5px] text-faint\"><span>File <code class=\"text-ink-2\">reel-sample.mp4</code></span><span>1080×1920</span><span>Used on <!-- -->Homepage Gravity section, /product/gravity/reels</span></div></div></div></section></div></main><script src=\"/_next/static/chunks/webpack-03f7c6bc932ce1e3.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/91d486bf57bf1762.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"2:I[2846,[],\\\"\\\"]\\n4:I[2972,[\\\"972\\\",\\\"static/chunks/972-8c0ee6fabcd1342f.js\\\",\\\"565\\\",\\\"static/chunks/app/admin/media/page-18dd953c065cc49f.js\\\"],\\\"\\\"]\\n5:I[4707,[],\\\"\\\"]\\n6:I[6423,[],\\\"\\\"]\\n8:I[2144,[\\\"972\\\",\\\"static/chunks/972-8c0ee6fabcd1342f.js\\\",\\\"309\\\",\\\"static/chunks/309-526a3bc2ba734d25.js\\\",\\\"878\\\",\\\"static/chunks/878-ed980f2cac33ad8c.js\\\",\\\"739\\\",\\\"static/chunks/739-3ece649a7e02ff75.js\\\",\\\"185\\\",\\\"static/chunks/app/layout-5a72189eaa6243d0.js\\\"],\\\"default\\\"]\\n9:I[6194,[\\\"972\\\",\\\"static/chunks/972-8c0ee6fabcd1342f.js\\\",\\\"309\\\",\\\"static/chunks/309-526a3bc2ba734d25.js\\\",\\\"878\\\",\\\"static/chunks/878-ed980f2cac33ad8c.js\\\",\\\"739\\\",\\\"static/chunks/739-3ece649a7e02ff75.js\\\",\\\"185\\\",\\\"static/chunks/app/layout-5a72189eaa6243d0.js\\\"],\\\"default\\\"]\\nb:I[1060,[],\\\"\\\"]\\n7:T5c5,{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Nebulaa\\\",\\\"legalName\\\":\\\"Noburo Business Services LLP\\\",\\\"url\\\":\\\"https://nebulaa.ai\\\",\\\"email\\\":\\\"hello@nebulaa.ai\\\",\\\"description\\\":\\\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\\\",\\\"foundingDate\\\":\\\"2025\\\",\\\"address\\\":{\\\"@type\\\":\\\"PostalAddress\\\",\\\"addressLocality\\\":\\\"Chennai\\\",\\\"addressRegion\\\":\\\"Tamil Nadu\\\",\\\"addressCountry\\\":\\\"IN\\\"},\\\"areaServed\\\":{\\\"@type\\\":\\\"