"Nebulaa Team\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"·\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"March 3, 2026\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"·\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"6 min read\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose-nebulaa\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"title: \\\\\\\"GTM Experiment #4: We Copied Our Competitor's Content Strategy for 3 Weeks\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"category: \\\\\\\"GTM Experiments\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"date: \\\\\\\"March 3, 2026\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"readTime: \\\\\\\"6 min read\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"author: \\\\\\\"Nebulaa Team\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"5\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h1\\\",\\\"6\\\",{\\\"className\\\":\\\"font-heading text-3xl font-bold text-brand-text dark:text-white mt-10 mb-4 tracking-tight\\\",\\\"children\\\":\\\"GTM Experiment #4: We Copied Our Competitor's Content Strategy for 3 Weeks\\\"}],[\\\"$\\\",\\\"div\\\",\\\"7\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"This started as a joke in a team meeting. \\\\\\\"Their LinkedIn is doing well. Should we just do what they're doing?\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"9\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"We weren't joking for long. Deepika runs a fintech startup in Hyderabad — expense management software for Indian SMBs. Her main competitor had nearly 8,000 LinkedIn followers, consistently got 50–100 likes per post, and seemed to dominate the conversation in their category. Deepika had 900 followers and posts that averaged 12 likes.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"11\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"She spent 2 hours analysing the competitor's last 60 posts. Then she instructed Gravity to mirror that content strategy exactly for 3 weeks. Here's what happened.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"13\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"14\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Competitor's Strategy (Reverse Engineered)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"15\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"After analysing 60 posts across 8 weeks, the competitor's formula was clear:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"17\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"18\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"**40% posts**: \\\\\\\"X things Indian CFOs get wrong\\\\\\\" — listicle format, slightly provocative headlines\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"19\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"**30% posts**: Feature announcements dressed up as insight (\\\\\\\"Why real-time expense visibility matters in Q4\\\\\\\")\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"20\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"**20% posts**: Customer success numbers (always round, always impressive)\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"21\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"**10% posts**: Founder commentary on GST/compliance news\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"22\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"23\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Average post length: 180–220 words. Posting frequency: 5 days per week. Always ended with a question to drive comments.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"24\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"25\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Gravity was briefed on this exact structure and tasked with replicating the format and topic cadence for Deepika's brand.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"26\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"27\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Week 1: Matching the Format\\\"}],[\\\"$\\\",\\\"div\\\",\\\"28\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"29\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Gravity produced 5 posts using the competitor's listicle-heavy format. Topics adapted for Deepika's angle (SMB-focused, not enterprise).\\\"}],[\\\"$\\\",\\\"div\\\",\\\"30\\\",{\\\"className\\\":\\\"my-3\\\"}],null,null,null,null,null,null,[\\\"$\\\",\\\"div\\\",\\\"37\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"38\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Immediate improvement. The format was clearly working better than what Deepika had been doing.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"39\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"40\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Week 2: The Voice Problem Emerges\\\"}],[\\\"$\\\",\\\"div\\\",\\\"41\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"42\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Week 2 started showing something unexpected. Engagement was up, but the replies in comments felt off. People were engaging with the format, but when they'd visit Deepika's profile or check previous posts, there was a tone mismatch. The listicle-heavy, authoritative voice didn't match the more conversational, founder-led content she'd posted before.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"43\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"44\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Three people explicitly commented things like \\\\\\\"this doesn't sound like your usual posts\\\\\\\" or \\\\\\\"different vibe this week.\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"45\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"46\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"One qualified lead who had been watching her content sent a DM asking if she'd changed her social media team.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"47\\\",{\\\"className\\\":\\\"my-3\\\"}],null,null,null,null,null,null,[\\\"$\\\",\\\"div\\\",\\\"54\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"55\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Impressions kept climbing. But the conversion signal — DMs and profile visits — started declining. The audience was entertained but less connected.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"56\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"57\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Week 3: Hybrid Approach\\\"}],[\\\"$\\\",\\\"div\\\",\\\"58\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"59\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"In week 3, Deepika and Gravity found a middle ground. Take the competitor's format structure (listicles, data, timely topics) but infuse her own voice, her own specific stories, and her own Hyderabad-based SMB examples.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"60\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"61\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"A post titled \\\\\\\"3 ways Hyderabad SMBs are leaking money through manual expense approvals\\\\\\\" — her voice, her market, competitor format — became her highest-performing post ever. 1,840 impressions. 64 likes. 11 comments. And 4 DMs.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"62\\\",{\\\"className\\\":\\\"my-3\\\"}],null,null,null,null,null,null,null,[\\\"$\\\",\\\"div\\\",\\\"70\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"71\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Big Lesson\\\"}],[\\\"$\\\",\\\"div\\\",\\\"72\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"73\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Copying a competitor's content strategy is actually a useful exercise — for understanding what format and cadence works in your category. But the mistake is copying the voice too.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"74\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"75\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Your competitors have built an audience. That audience trusts their specific perspective and personality. If you replicate the structure but borrow their voice, you're not attracting your audience — you're building a pale imitation of theirs.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"76\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"77\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"The right move: steal the format, keep the voice.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"78\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"79\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Gravity's competitor tracking feature is designed for exactly this — it monitors what's working in your category and uses those signals to generate content that fits your brand, not your competitor's.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"80\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"81\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Conclusion\\\"}],[\\\"$\\\",\\\"div\\\",\\\"82\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"83\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Deepika ended the 3-week experiment with 75 new followers, 2 demo conversations, and a much better understanding of what format her market responds to. She also learned that the thing that made her content convert wasn't format — it was specificity. Her city. Her customers. Her stories.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"84\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"85\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"86\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Key Takeaways\\\"}],[\\\"$\\\",\\\"div\\\",\\\"87\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"88\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Your competitor's content format is worth studying and adapting\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"89\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Copying their voice creates brand confusion and hurts conversion\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"90\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Specificity (city, industry, real customer stories) drives DMs more than generic engagement\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"91\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"The best strategy: competitor's format + your brand voice + your market's context\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"92\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"93\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"94\\\",{\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/50 italic my-2\\\",\\\"children\\\":\\\"Want Gravity to track your competitors and use their signals to improve your own content? [Start your free 7-day trial →](/)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"95\\\",{\\\"className\\\":\\\"my-3\\\"}]]}],[\\\"$\\\",\\\"$Le\\\",null,{}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 bg-brand-gold-pale dark:bg-brand-gold/8 border border-brand-gold/20 dark:border-brand-gold/15 rounded-2xl p-6 text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-heading text-lg font-bold text-brand-text dark:text-white mb-2\\\",\\\"children\\\":\\\"Ready to automate your GTM?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/50 mb-4\\\",\\\"children\\\":\\\"100 free credits. No card required. Setup in 24 hours.\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/pricing\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 bg-brand-gold text-brand-black font-body font-semibold rounded-full px-6 py-3 hover:bg-brand-gold-dim transition-all hover:scale-[1.03]\\\",\\\"children\\\":\\\"Start your free trial →\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 text-center\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/30 hover:text-brand-gold dark:hover:text-brand-gold transition-colors\\\",\\\"children\\\":\\\"← Back to all posts\\\"}]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"b:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach Agents for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated. Gravity posts, Pulsar calls. Built for Indian founders and SMBs. Start free — 100 credits, no card.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"link\\\",\\\"6\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Nebulaa.ai — Your GTM Team Just Showed Up\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Gravity posts. Pulsar calls. You close.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"property\\\":\\\"og:site_name\\\",\\\"content\\\":\\\"Nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"en_IN\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"name\\\":\\\"twitter:site\\\",\\\"content\\\":\\\"@nebulaaai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated.\\\"}],[\\\"$\\\",\\\"link\\\",\\\"17\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n3:null\\n\"])</script></body></html>","rsc":"3:I[4707,[],\"\"]\n5:I[6423,[],\"\"]\n7:I[2144,[\"972\",\"static/chunks/972-8c0ee6fabcd1342f.js\",\"309\",\"static/chunks/309-526a3bc2ba734d25.js\",\"878\",\"static/chunks/878-ed980f2cac33ad8c.js\",\"739\",\"static/chunks/739-3ece649a7e02ff75.js\",\"185\",\"static/chunks/app/layout-5a72189eaa6243d0.js\"],\"default\"]\n8:I[6194,[\"972\",\"static/chunks/972-8c0ee6fabcd1342f.js\",\"309\",\"static/chunks/309-526a3bc2ba734d25.js\",\"878\",\"static/chunks/878-ed980f2cac33ad8c.js\",\"739\",\"static/chunks/739-3ece649a7e02ff75.js\",\"185\",\"static/chunks/app/layout-5a72189eaa6243d0.js\"],\"default\"]\n4:[\"slug\",\"gtm-experiment-competitor-content-strategy\",\"d\"]\n6:T5c5,{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"legalName\":\"Noburo Business Services LLP\",\"url\":\"https://nebulaa.ai\",\"email\":\"hello@nebulaa.ai\",\"description\":\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\",\"foundingDate\":\"2025\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressRegion\":\"Tamil Nadu\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"},\"makesOffer\":[{\"@type\":\"Offer\",\"name\":\"Gravity\",\"price\":\"10000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Gravity\",\"description\":\"Reads a website and builds a marketing strategy from it, plans the month, drafts posts, carousels and reels, tracks competitors, runs campaigns and creator collaborations, and handles the social inbox.\"}},{\"@type\":\"Offer\",\"name\":\"Pulsar\",\"price\":\"15000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Pulsar\",\"description\":\"Answers enquiries on WhatsApp, email and SMS within minutes, qualifies budget, timeline and fit, scores every lead, and runs broadcasts, automation and voice calling.\"}},{\"@type\":\"Offer\",\"name\":\"Both agents\",\"price\":\"20000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Both agents\",\"description\":\"Gravity and Pulsar on one account, sharing the same brand memory.\"}}]}0:[\"vqg3I8PMiwBbcgwQxIKIJ\",[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"gtm-experiment-competitor-content-strategy\",\"d\"],{\"children\":[\"__PAGE__?{\\\"slug\\\":\\\"gtm-experiment-competitor-content-strategy\\\"}\",{}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"gtm-experiment-competitor-content-strategy\",\"d\"],{\"children\":[\"__PAGE__\",{},[[\"$L1\",\"$L2\",null],null],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\",\"$4\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\"}]],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\"}]],null]},[[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/91d486bf57bf1762.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://fonts.googleapis.com\"}],[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://fonts.gstatic.com\",\"crossOrigin\":\"anonymous\"}],[\"$\",\"link\",null,{\"href\":\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap\",\"rel\":\"stylesheet\"}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$6\"}}]]}],[\"$\",\"body\",null,{\"className\":\"bg-ground text-ink font-body antialiased\",\"children\":[\"$\",\"$L7\",null,{\"children\":[\"$\",\"$L8\",null,{\"children\":[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":\"404\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],\"notFoundStyles\":[]}]}]}]}]]}]],null],null],[\"$L9\",null]]]]\na:I[1644,[\"308\",\"static/chunks/app/blog/%5Bslug%5D/page-4ebbaccc1d438f3e.js\"],\"default\"]\n2:[\"$\",\"main\",null,{\"className\":\"bg-white dark:bg-[#0A0A0A] min-h-screen pt-24 pb-20 transition-colors\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-2xl mx-auto px-4 md:px-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-1.5 w-16 bg-gradient-to-r from-purple-500/20 to-purple-400/5 rounded-full mb-6\"}],[\"$\",\"span\",null,{\"className\":\"inline-block font-body text-xs font-semibold bg-brand-gold text-brand-black px-3 py-1 rounded-full mb-4\",\"children\":\"GTM Experiments\"}],[\"$\",\"h1\",null,{\"className\":\"font-heading font-bold text-3xl md:text-4xl text-brand-text dark:text-white leading-tight mb-4 tracking-tight\",\"children\":\"GTM Experiment #4: We Copied Our Competitor's Content Strategy for 3 Weeks\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-body text-sm text-brand-muted dark:text-white/40\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Nebulaa Team\"}],[\"$\",\"span\",null,{\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":\"March 3, 2026\"}],[\"$\",\"span\",null,{\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":\"6 min read\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"prose-nebulaa\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"title: \\\"GTM Experiment #4: We Copied Our Competitor's Content Strategy for 3 Weeks\\\"\"}],[\"$\",\"p\",\"1\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"category: \\\"GTM Experiments\\\"\"}],[\"$\",\"p\",\"2\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"date: \\\"March 3, 2026\\\"\"}],[\"$\",\"p\",\"3\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"readTime: \\\"6 min read\\\"\"}],[\"$\",\"p\",\"4\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"author: \\\"Nebulaa Team\\\"\"}],[\"$\",\"div\",\"5\",{\"className\":\"my-3\"}],[\"$\",\"h1\",\"6\",{\"className\":\"font-heading text-3xl font-bold text-brand-text dark:text-white mt-10 mb-4 tracking-tight\",\"children\":\"GTM Experiment #4: We Copied Our Competitor's Content Strategy for 3 Weeks\"}],[\"$\",\"div\",\"7\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"8\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"This started as a joke in a team meeting. \\\"Their LinkedIn is doing well. Should we just do what they're doing?\\\"\"}],[\"$\",\"div\",\"9\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"10\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"We weren't joking for long. Deepika runs a fintech startup in Hyderabad — expense management software for Indian SMBs. Her main competitor had nearly 8,000 LinkedIn followers, consistently got 50–100 likes per post, and seemed to dominate the conversation in their category. Deepika had 900 followers and posts that averaged 12 likes.\"}],[\"$\",\"div\",\"11\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"12\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"She spent 2 hours analysing the competitor's last 60 posts. Then she instructed Gravity to mirror that content strategy exactly for 3 weeks. Here's what happened.\"}],[\"$\",\"div\",\"13\",{\"className\":\"my-3\"}],[\"$\",\"h2\",\"14\",{\"className\":\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\",\"children\":\"The Competitor's Strategy (Reverse Engineered)\"}],[\"$\",\"div\",\"15\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"16\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"After analysing 60 posts across 8 weeks, the competitor's formula was clear:\"}],[\"$\",\"div\",\"17\",{\"className\":\"my-3\"}],[\"$\",\"div\",\"18\",{\"className\":\"flex items-start gap-2 my-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\",\"children\":\"**40% posts**: \\\"X things Indian CFOs get wrong\\\" — listicle format, slightly provocative headlines\"}]]}],[\"$\",\"div\",\"19\",{\"className\":\"flex items-start gap-2 my-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\",\"children\":\"**30% posts**: Feature announcements dressed up as insight (\\\"Why real-time expense visibility matters in Q4\\\")\"}]]}],[\"$\",\"div\",\"20\",{\"className\":\"flex items-start gap-2 my-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\",\"children\":\"**20% posts**: Customer success numbers (always round, always impressive)\"}]]}],[\"$\",\"div\",\"21\",{\"className\":\"flex items-start gap-2 my-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\",\"children\":\"**10% posts**: Founder commentary on GST/compliance news\"}]]}],[\"$\",\"div\",\"22\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"23\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Average post length: 180–220 words. Posting frequency: 5 days per week. Always ended with a question to drive comments.\"}],[\"$\",\"div\",\"24\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"25\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Gravity was briefed on this exact structure and tasked with replicating the format and topic cadence for Deepika's brand.\"}],[\"$\",\"div\",\"26\",{\"className\":\"my-3\"}],[\"$\",\"h2\",\"27\",{\"className\":\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\",\"children\":\"Week 1: Matching the Format\"}],[\"$\",\"div\",\"28\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"29\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Gravity produced 5 posts using the competitor's listicle-heavy format. Topics adapted for Deepika's angle (SMB-focused, not enterprise).\"}],[\"$\",\"div\",\"30\",{\"className\":\"my-3\"}],null,null,null,null,null,null,[\"$\",\"div\",\"37\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"38\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Immediate improvement. The format was clearly working better than what Deepika had been doing.\"}],[\"$\",\"div\",\"39\",{\"className\":\"my-3\"}],[\"$\",\"h2\",\"40\",{\"className\":\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\",\"children\":\"Week 2: The Voice Problem Emerges\"}],[\"$\",\"div\",\"41\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"42\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Week 2 started showing something unexpected. Engagement was up, but the replies in comments felt off. People were engaging with the format, but when they'd visit Deepika's profile or check previous posts, there was a tone mismatch. The listicle-heavy, authoritative voice didn't match the more conversational, founder-led content she'd posted before.\"}],[\"$\",\"div\",\"43\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"44\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Three people explicitly commented things like \\\"this doesn't sound like your usual posts\\\" or \\\"different vibe this week.\\\"\"}],[\"$\",\"div\",\"45\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"46\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"One qualified lead who had been watching her content sent a DM asking if she'd changed her social media team.\"}],[\"$\",\"div\",\"47\",{\"className\":\"my-3\"}],null,null,null,null,null,null,[\"$\",\"div\",\"54\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"55\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Impressions kept climbing. But the conversion signal — DMs and profile visits — started declining. The audience was entertained but less connected.\"}],[\"$\",\"div\",\"56\",{\"className\":\"my-3\"}],[\"$\",\"h2\",\"57\",{\"className\":\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\",\"children\":\"Week 3: Hybrid Approach\"}],[\"$\",\"div\",\"58\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"59\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"In week 3, Deepika and Gravity found a middle ground. Take the competitor's format structure (listicles, data, timely topics) but infuse her own voice, her own specific stories, and her own Hyderabad-based SMB examples.\"}],[\"$\",\"div\",\"60\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"61\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"A post titled \\\"3 ways Hyderabad SMBs are leaking money through manual expense approvals\\\" — her voice, her market, competitor format — became her highest-performing post ever. 1,840 impressions. 64 likes. 11 comments. And 4 DMs.\"}],[\"$\",\"div\",\"62\",{\"className\":\"my-3\"}],null,null,null,null,null,null,null,[\"$\",\"div\",\"70\",{\"className\":\"my-3\"}],[\"$\",\"h2\",\"71\",{\"className\":\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\",\"children\":\"The Big Lesson\"}],[\"$\",\"div\",\"72\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"73\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Copying a competitor's content strategy is actually a useful exercise — for understanding what format and cadence works in your category. But the mistake is copying the voice too.\"}],[\"$\",\"div\",\"74\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"75\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Your competitors have built an audience. That audience trusts their specific perspective and personality. If you replicate the structure but borrow their voice, you're not attracting your audience — you're building a pale imitation of theirs.\"}],[\"$\",\"div\",\"76\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"77\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"The right move: steal the format, keep the voice.\"}],[\"$\",\"div\",\"78\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"79\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Gravity's competitor tracking feature is designed for exactly this — it monitors what's working in your category and uses those signals to generate content that fits your brand, not your competitor's.\"}],[\"$\",\"div\",\"80\",{\"className\":\"my-3\"}],[\"$\",\"h2\",\"81\",{\"className\":\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\",\"children\":\"Conclusion\"}],[\"$\",\"div\",\"82\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"83\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Deepika ended the 3-week experiment with 75 new followers, 2 demo conversations, and a much better understanding of what format her market responds to. She also learned that the thing that made her content convert wasn't format — it was specificity. Her city. Her customers. Her stories.\"}],[\"$\",\"div\",\"84\",{\"className\":\"my-3\"}],[\"$\",\"div\",\"85\",{\"className\":\"my-3\"}],[\"$\",\"h2\",\"86\",{\"className\":\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\",\"children\":\"Key Takeaways\"}],[\"$\",\"div\",\"87\",{\"className\":\"my-3\"}],[\"$\",\"div\",\"88\",{\"className\":\"flex items-start gap-2 my-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\",\"children\":\"Your competitor's content format is worth studying and adapting\"}]]}],[\"$\",\"div\",\"89\",{\"className\":\"flex items-start gap-2 my-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\",\"children\":\"Copying their voice creates brand confusion and hurts conversion\"}]]}],[\"$\",\"div\",\"90\",{\"className\":\"flex items-start gap-2 my-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\",\"children\":\"Specificity (city, industry, real customer stories) drives DMs more than generic engagement\"}]]}],[\"$\",\"div\",\"91\",{\"className\":\"flex items-start gap-2 my-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\",\"children\":\"The best strategy: competitor's format + your brand voice + your market's context\"}]]}],[\"$\",\"div\",\"92\",{\"className\":\"my-3\"}],[\"$\",\"div\",\"93\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"94\",{\"className\":\"font-body text-sm text-brand-muted dark:text-white/50 italic my-2\",\"children\":\"Want Gravity to track your competitors and use their signals to improve your own content? [Start your free 7-day trial →](/)\"}],[\"$\",\"div\",\"95\",{\"className\":\"my-3\"}]]}],[\"$\",\"$La\",null,{}],[\"$\",\"div\",null,{\"className\":\"mt-8 bg-brand-gold-pale dark:bg-brand-gold/8 border border-brand-gold/20 dark:border-brand-gold/15 rounded-2xl p-6 text-center\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-heading text-lg font-bold text-brand-text dark:text-white mb-2\",\"children\":\"Ready to automate your GTM?\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-sm text-brand-muted dark:text-white/50 mb-4\",\"children\":\"100 free credits. No card required. Setup in 24 hours.\"}],[\"$\",\"a\",null,{\"href\":\"/pricing\",\"className\":\"inline-flex items-center gap-2 bg-brand-gold text-brand-black font-body font-semibold rounded-full px-6 py-3 hover:bg-brand-gold-dim transition-all hover:scale-[1.03]\",\"children\":\"Start your free trial →\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-8 text-center\",\"children\":[\"$\",\"a\",null,{\"href\":\"/blog\",\"className\":\"font-body text-sm text-brand-muted dark:text-white/30 hover:text-brand-gold dark:hover:text-brand-gold transition-colors\",\"children\":\"← Back to all posts\"}]}]]}]}]\n9:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"2\",{\"children\":\"Nebulaa.ai — AI Marketing & Outreach Agents for Founders\"}],[\"$\",\"meta\",\"3\",{\"name\":\"description\",\"content\":\"Two AI agents. Your entire GTM. Automated. Gravity posts, Pulsar calls. Built for Indian founders and SMBs. Start free — 100 credits, no card.\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\"}],[\"$\",\"meta\",\"5\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"link\",\"6\",{\"rel\":\"canonical\",\"href\":\"https://nebulaa.ai\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:title\",\"content\":\"Nebulaa.ai — Your GTM Team Just Showed Up\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:description\",\"content\":\"Gravity posts. Pulsar calls. You close.\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:url\",\"content\":\"https://nebulaa.ai\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:site_name\",\"content\":\"Nebulaa.ai\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:locale\",\"content\":\"en_IN\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:site\",\"content\":\"@nebulaaai\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:title\",\"content\":\"Nebulaa.ai — AI Marketing & Outreach for Founders\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:description\",\"content\":\"Two AI agents. Your entire GTM. Automated.\"}],[\"$\",\"link\",\"17\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}]]\n1:null\n"}