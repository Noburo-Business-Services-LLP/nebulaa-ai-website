=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-twitter\" aria-hidden=\"true\"><path d=\"M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z\"></path></svg></span></div><hr class=\"border-t border-rule mb-[26px]\"/><div class=\"flex flex-col gap-[13px] mb-9\"><div class=\"font-body text-[14.5px] text-ink-2\">Marketing strategy &amp; ICP, built in</div><div class=\"font-body text-[14.5px] text-ink-2\">Monthly content plan, auto-generated</div><div class=\"font-body text-[14.5px] text-ink-2\">Posts, carousels &amp; AI reels</div><div class=\"font-body text-[14.5px] text-ink-2\">Competitor tracking → counter-content</div><div class=\"font-body text-[14.5px] text-ink-2\">Learns your brand over time</div><div class=\"font-body text-[14.5px] text-ink-2\">LinkedIn, Instagram &amp; X</div><div class=\"font-body text-[14.5px] text-ink-2\">7-day free trial</div></div><a href=\"#\" class=\"w-full text-center font-body font-semibold text-[14.5px] rounded-full py-[15px] block transition-all hover:scale-[1.02] active:scale-[0.98] border border-rule-2 text-ink-2 hover:border-gold hover:text-gold-text\">Start with Gravity</a></div><div class=\"relative bg-surface rounded-[20px] p-6 md:p-10 border border-gold/[0.22] shadow-[inset_0_1px_0_0_rgba(255,214,150,0.07),0_18px_60px_rgba(245,166,35,0.07)]\" style=\"opacity:0;transform:translateY(32px)\"><span class=\"neb-label neb-label-gold mb-5 block\">Both agents · best value</span><div class=\"flex items-baseline gap-2 mb-2.5\"><span class=\"font-heading text-[46px] tracking-[-0.02em] leading-none\">₹20,000</span><span class=\"font-body text-sm text-faint\">/month</span></div><p class=\"font-body text-[14.5px] leading-[1.6] text-muted mb-5\">The whole loop — content in, customers out. ₹5,000 less than buying the two separately.</p><div class=\"flex items-center gap-3 mb-[30px]\"