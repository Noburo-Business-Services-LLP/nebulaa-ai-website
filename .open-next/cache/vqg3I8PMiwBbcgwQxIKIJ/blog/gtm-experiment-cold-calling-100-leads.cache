ssName\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"title: \\\\\\\"GTM Experiment #2: We Had Pulsar Call 100 Leads in One Week. 14 Booked Demos.\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"category: \\\\\\\"GTM Experiments\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"date: \\\\\\\"March 12, 2026\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"readTime: \\\\\\\"7 min read\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"author: \\\\\\\"Nebulaa Team\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"5\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h1\\\",\\\"6\\\",{\\\"className\\\":\\\"font-heading text-3xl font-bold text-brand-text dark:text-white mt-10 mb-4 tracking-tight\\\",\\\"children\\\":\\\"GTM Experiment #2: We Had Pulsar Call 100 Leads in One Week. 14 Booked Demos.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"7\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Priya came back from the India Beauty \\u0026 Wellness Expo in Mumbai with 100 business cards. Buyers, distributors, salon chain owners — the kind of leads that take months to generate through inbound. She had one week before the post-expo buzz faded and people forgot who she was.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"9\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"She had no sales team. Just herself, a co-founder who was heads-down on product, and a very long to-do list. She gave all 100 leads to Pulsar.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"11\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Here's what happened.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"13\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"14\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Problem\\\"}],[\\\"$\\\",\\\"div\\\",\\\"15\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Business cards from trade shows have a brutal decay curve. Contact someone within 48 hours and they remember you. Wait a week and you're just another card in a pile on their desk. Wait two weeks and you're in the bin.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"17\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"18\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Priya had 100 leads. Manually calling even 20 of them properly — researching, scripting, dialing, following up — would take 3–4 full days. She didn't have that time. So she ran an experiment.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"19\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"20\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Setup\\\"}],[\\\"$\\\",\\\"div\\\",\\\"21\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"22\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Pulsar was configured with the following parameters:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"23\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"24\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Script tone**: Warm, not salesy. \\\\\\\"I'm calling to continue the conversation from the expo\\\\\\\" energy, not cold pitch energy.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"25\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"26\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Qualification criteria**:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"27\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Does the lead distribute or retail beauty/wellness products?\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"28\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Do they have 3+ locations or an online presence?\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"29\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Are they evaluating new brands for their next buy cycle?\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"30\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"31\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Call timing**: 10 AM–12 PM and 3 PM–5 PM IST only (Priya's ICP answers calls during these windows, not during lunch or evening).\\\"}],[\\\"$\\\",\\\"div\\\",\\\"32\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"33\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Follow-up sequence**: Leads who didn't pick up got a WhatsApp message 30 minutes later. Leads who picked up but weren't ready got added to a 21-day nurture sequence.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"34\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"35\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Numbers\\\"}],[\\\"$\\\",\\\"div\\\",\\\"36\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"37\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Pulsar worked through all 100 leads over 4 days (calls were spread to avoid spam flags).\\\"}],[\\\"$\\\",\\\"div\\\",\\\"38\\\",{\\\"className\\\":\\\"my-3\\\"}],null,null,null,null,null,null,null,null,null,null,null,null,[\\\"$\\\",\\\"div\\\",\\\"51\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"52\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"14 demos booked. 3 of those converted to paid distributors within 30 days, generating ₹1.8L in first orders.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"53\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"54\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"What a Qualifying Call Actually Sounded Like\\\"}],[\\\"$\\\",\\\"div\\\",\\\"55\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"56\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Here's a lightly edited transcript from one of the calls:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"57\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"58\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"59\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Pulsar**: Hi, this is an automated call on behalf of Priya from Velara Naturals. You met at the India Beauty Expo last week. She wanted to personally follow up. Is this a good time for a 90-second conversation?\\\"}],[\\\"$\\\",\\\"div\\\",\\\"60\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"61\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Lead**: Oh, Velara — yes, the herbal skincare one?\\\"}],[\\\"$\\\",\\\"div\\\",\\\"62\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"63\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Pulsar**: That's right. Priya wanted to check — are you currently sourcing herbal skincare for your stores, or is that a category you're looking to add?\\\"}],[\\\"$\\\",\\\"div\\\",\\\"64\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"65\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Lead**: We're looking, actually. We have four stores in Pune.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"66\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"67\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Pulsar**: Perfect. Priya has a slot open Thursday at 11 AM or Friday at 2 PM to walk you through the distributor programme. Which works better for you?\\\"}],[\\\"$\\\",\\\"div\\\",\\\"68\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"69\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Lead**: Thursday is fine.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"70\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"71\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Pulsar**: Confirmed. She'll send a calendar invite to this number. Anything specific you'd like her to prepare for the call?\\\"}],[\\\"$\\\",\\\"div\\\",\\\"72\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"73\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"74\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Total call length: 2 minutes 14 seconds. The lead didn't feel called by a bot — they felt followed up with, personally, by the founder.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"75\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"76\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"What Worked\\\"}],[\\\"$\\\",\\\"div\\\",\\\"77\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"78\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Speed mattered most.** The calls went out within 24 hours of Priya uploading the contacts. People remembered the expo. The window was fresh.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"79\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"80\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Short and specific beats long and generic.** Pulsar's script didn't try to close on the first call. It just re-established context, qualified intent, and booked a slot. That's it.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"81\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"82\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**WhatsApp follow-up recovered almost 30% of the missed calls.** Of the 38 voicemails, 11 replied to WhatsApp — that's a 29% recovery rate on calls that would have otherwise been dead.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"83\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"84\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"What Didn't Work\\\"}],[\\\"$\\\",\\\"div\\\",\\\"85\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"86\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**15 leads were wrong-segment entirely** — they were expo visitors who weren't buyers at all. This contaminated the list and lowered the overall pickup-to-qualified ratio. Better list hygiene upfront would have improved the numbers.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"87\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"88\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"**Leads outside Maharashtra answered less.** Pick-up rates in Delhi and Bangalore were lower — possibly time zone or cultural call-answer habits. Regional timing adjustments would help.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"89\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"90\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"ROI Calculation\\\"}],[\\\"$\\\",\\\"div\\\",\\\"91\\\",{\\\"className\\\":\\\"my-3\\\"}],null,null,null,null,null,null,null,null,[\\\"$\\\",\\\"div\\\",\\\"100\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"101\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Even if you exclude the closed revenue and just count the demo pipeline — 14 conversations with qualified buyers that Priya didn't have to make manually — the value is obvious.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"102\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"103\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Conclusion\\\"}],[\\\"$\\\",\\\"div\\\",\\\"104\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"105\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"100 leads, 4 days, ₹3,200 spent. 14 demos, 3 conversions, ₹1.8L in pipeline. Priya's manual effort would have been 3–4 full days and maybe 8 demos if she was lucky.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"106\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"107\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"The experiment is repeatable. If you have leads sitting in a spreadsheet right now — from a trade show, a website, an event — Pulsar can work through them faster than any SDR you could hire.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"108\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"109\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"110\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Key Takeaways\\\"}],[\\\"$\\\",\\\"div\\\",\\\"111\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"112\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Speed of follow-up is the single biggest driver of trade show lead conversion\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"113\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"WhatsApp recovery on missed calls adds ~30% to effective reach\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"114\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Short, specific qualification calls outperform long pitches\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"115\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"List hygiene matters — clean your leads before uploading for better ROI\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"116\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"117\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"118\\\",{\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/50 italic my-2\\\",\\\"children\\\":\\\"Want Pulsar to work through your lead backlog? [Start your free 7-day trial →](/)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"119\\\",{\\\"className\\\":\\\"my-3\\\"}]]}],[\\\"$\\\",\\\"$Le\\\",null,{}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 bg-brand-gold-pale dark:bg-brand-gold/8 border border-brand-gold/20 dark:border-brand-gold/15 rounded-2xl p-6 text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-heading text-lg font-bold text-brand-text dark:text-white mb-2\\\",\\\"children\\\":\\\"Ready to automate your GTM?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/50 mb-4\\\",\\\"children\\\":\\\"100 free credits. No card required. Setup in 24 hours.\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/pricing\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 bg-brand-gold text-brand-black font-body font-semibold rounded-full px-6 py-3 hover:bg-brand-gold-dim transition-all hover:scale-[1.03]\\\",\\\"children\\\":\\\"Start your free trial →\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 text-center\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/30 hover:text-brand-gold dark:hover:text-brand-gold transition-colors\\\",\\\"children\\\":\\\"← Back to all posts\\\"}]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"b:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach Agents for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated. Gravity posts, Pulsar calls. Built for Indian founders and SMBs. Start free — 100 credits, no card.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"link\\\",\\\"6\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Nebulaa.ai — Your GTM Team Just Showed Up\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Gravity posts. Pulsar calls. You close.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"property\\\":\\\"og:site_name\\\",\\\"content\\\":\\\"Nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"en_IN\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"name\\\":\\\"twitter:site\\\",\\\"content\\\":\\\"@nebulaaai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated.\\\"}],[\\\"$\\\",\\\"link\\\",\\\"17\