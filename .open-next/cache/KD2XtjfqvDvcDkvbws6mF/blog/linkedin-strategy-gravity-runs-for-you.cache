-3\\\",\\\"children\\\":\\\"This feeds the content calendar automatically.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"36\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"37\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Step 4: The Daily Content Queue\\\"}],[\\\"$\\\",\\\"div\\\",\\\"38\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"39\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Every morning, Gravity generates 3 posts:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"40\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"1 thought leadership piece (LinkedIn long-form)\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"41\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"1 short-form hook (Twitter/X thread starter)\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"42\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"1 visual caption (Instagram)\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"43\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"44\\\",