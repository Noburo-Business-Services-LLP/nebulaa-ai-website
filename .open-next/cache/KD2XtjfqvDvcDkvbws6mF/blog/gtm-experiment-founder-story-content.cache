ame\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"readTime: \\\"5 min read\\\"\"}],[\"$\",\"p\",\"4\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"author: \\\"Nebulaa Team\\\"\"}],[\"$\",\"div\",\"5\",{\"className\":\"my-3\"}],[\"$\",\"h1\",\"6\",{\"className\":\"font-heading text-3xl font-bold text-brand-text dark:text-white mt-10 mb-4 tracking-tight\",\"children\":\"GTM Experiment #5: Founder Story Posts vs Product Posts — Which Got More Leads?\"}],[\"$\",\"div\",\"7\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"8\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"The debate shows up in every founder Slack group eventually. \\\"Should I post about my product or about my journey?\\\" Most people guess the answer. We measured it.\"}],[\"$\",\"div\",\"9\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"10\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Sameer runs an edtech startup in Pune. He'd been inconsistently posting a mix of product updates and personal founder stories on LinkedIn for about 6 months. He had 2,400 followers and a vague sense that his personal posts did better — but he'd never actually tracked what generated business conversations.\"}],[\"$\",\"div\",\"11\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"12\",{\"className\":\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\",\"children\":\"Over 6 weeks, using Gravity, he ran a clean split test: 20 founder story posts vs 20 product-focused posts. Here's what the data showed.\"}],[\"$\",\"div\",\"13\",{\"className\":\"my-3\"}],[\"$\",\"h2\",\"14\",{\"className\":\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\",\"children\":\"The Setup\"}],[\"$\",\"div\",\"15\",{\"className\":\"my-3\"}],[\"$\",\"p\",\"16\",{