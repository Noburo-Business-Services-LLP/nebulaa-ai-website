\",null,{\"className\":\"flex items-center gap-1.5 text-[14px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\",\"children\":[\"What it includes \",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"bg-surface-2 border border-rule rounded-[14px] px-5 py-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"neb-label mb-2.5\",\"children\":\"Suited to\"}],[\"$\",\"p\",null,{\"className\":\"text-[14px] leading-[1.6] text-ink-2\",\"children\":\"Brands with distribution across several markets, regions or retail networks\"}]]}]]}]}]]}]}],[\"$\",\"hr\",null,{\"className\":\"border-t border-rule\"}],[\"$\",\"section\",null,{\"className\":\"px-6 md:px-12 lg:px-[120px] py-[100px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-[680px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"neb-label neb-label-gold mb-[20px] block\",\"children\":\"On results\"}],[\"$\",\"h2\",null,{\"className\":\"font-heading font-medium text-[28px] md:text-[38px] leading-[1.14] tracking-[-0.02em] mb-5\",\"children\":\"No numbers on these pages yet.\"}],[\"$\",\"p\",null,{\"className\":\"text-[16px] leading-[1.68] text-muted mb-4\",\"children\":\"We could put growth figures here. Plenty of sites in this category do, and a fair few of those figures contradict themselves from one page to the next.\"}],[\"$\",\"p\",null,{\"className\":\"text-[16px] leading-[1.68] text-muted\",\"children\":\"Ours go up when there is client work published with permission behind it, and not before. Until then these pages describe scope and cadence, which are things 