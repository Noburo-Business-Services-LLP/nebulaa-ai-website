# Admin password (set this to anything you want)
ADMIN_SECRET=your-admin-secret-here

# Claude AI (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP Email Settings
# For Gmail: host=smtp.gmail.com, port=587, use App Password (not your main password)
# For Zoho: host=smtp.zoho.in, port=587
# For custom domain: check your hosting provider
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=hello@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Your Name <hello@yourdomain.com>

# --- Analytics & Ads tags ---
# Leave any of these blank to disable that tag entirely (nothing loads, no errors).
# Google Tag Manager container ID (e.g. GTM-XXXXXXX). If set, this loads instead of
# raw GA4/Google Ads tags — configure GA4 and Google Ads conversion tags inside GTM.
NEXT_PUBLIC_GTM_ID=
# GA4 measurement ID (e.g. G-XXXXXXXXXX). Only used if NEXT_PUBLIC_GTM_ID is blank.
NEXT_PUBLIC_GA4_ID=
# Google Ads conversion ID (e.g. AW-XXXXXXXXX). Only used if NEXT_PUBLIC_GTM_ID is blank.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Meta Pixel ID from Events Manager. Only loads after a visitor accepts cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API access token (server-side, never NEXT_PUBLIC_) — for the /api/capi route.
META_CAPI_ACCESS_TOKEN=
