eywords\" content=\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://nebulaa.ai\"/><meta property=\"og:title\" content=\"Nebulaa.ai — Your GTM Team Just Showed Up\"/><meta property=\"og:description\" content=\"Gravity posts. Pulsar calls. You close.\"/><meta property=\"og:url\" content=\"https://nebulaa.ai\"/><meta property=\"og:site_name\" content=\"Nebulaa.ai\"/><meta property=\"og:locale\" content=\"en_IN\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@nebulaaai\"/><meta name=\"twitter:title\" content=\"Nebulaa.ai — AI Marketing &amp; Outreach for Founders\"/><meta name=\"twitter:description\" content=\"Two AI agents. Your entire GTM. Automated.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&amp;family=Inter:wght@300;400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap\" rel=\"stylesheet\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"legalName\":\"Noburo Business Services LLP\",\"url\":\"https://nebulaa.ai\",\"email\":\"hello@nebulaa.ai\",\"description\":\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\",\"foundingDate\":\"2025\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressRegion\":\"Tamil Nadu\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"},\"makesOffer\":[{\"@type\":\"Offer\",\"name\":\"Gravity\",\"price\":\"10000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Gravity\",\"description\":\"Reads a website and builds a marketing strategy from it, plans the month, drafts posts, carousels and reels, tracks competitors, runs campaigns and creator collaborations, and handles the social inbox.\"}},{\"@type\":\"Offer\",\"name\":\"Pulsar\",\"price\":\"15000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Pulsar\",\"description\":\"Answers enquiries on WhatsApp, email and SMS within minutes, qualifies budget, timeline and fit, scores every lead, and runs broadcasts, automation and voice calling.\"}},{\"@type\":\"Offer\",\"name\":\"Both agents\",\"price\":\"20000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Both agents\",\"description\":\"Gravity and Pulsar on one account, sharing the same brand memory.\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"bg-ground text-ink font-body antialiased\"><nav class=\"fixed top-0 left-0 right-0 z-50 border-b border-rule transition-all duration-300 bg-ground/80 backdrop-blur-sm\" style=\"transform:translateY(-64px)\"><div class=\"flex items-center justify-between py-7 px-6 md:px-12 lg:px-[120px]\"><a class=\"flex-shrink-0\" href=\"/\"><img alt=\"Nebulaa.ai\" fetchPriority=\"high\" loading=\"eager\" width=\"160\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-10 w-auto hover:opacity-80 transition-opacity dark:hidden\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo-light.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-light.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo-light.png&amp;w=384&amp;q=75\"/><img alt=\"\" aria-hidden=\"true\" fetchPriority=\"high\" loading=\"eager\" width=\"160\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-10 w-auto hover:opacity-80 transition-opacity brightness-110 hidden dark:block\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=384&amp;q=75\"/></a><div class=\"hidden md:flex items-center gap-[38px]\"><div class=\"relative\"><button class=\"flex items-center gap-1 font-body text-sm text-muted hover:text-ink transition-colors\" aria-expanded=\"false\">Product<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><a class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\" href=\"/channels\">Channels<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><a class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\" href=\"/services\">Services<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><a href=\"/pricing\" class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\">Pricing<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><div class=\"relative\"><button class=\"flex items-center gap-1 font-body text-sm text-muted hover:text-ink transition-colors\" aria-expanded=\"false\">Resources<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div></div><div class=\"hidden md:flex items-center gap-3.5\"><a href=\"#\" class=\"font-body text-sm text-muted hover:text-ink transition-colors\">Sign in</a><a href=\"/pricing\" class=\"font-body text-sm font-semibold bg-brand-gold text-brand-black rounded-full px-[22px] py-[11px] shadow-[0_4px_18px_rgba(245,166,35,0.20)] hover:bg-brand-gold-dim transition-all\">Start free</a></div><div class=\"md:hidden flex items-center gap-2\"><button class=\"text-ink\" aria-label=\"Open menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></nav><main class=\"bg-white dark:bg-[#0A0A0A] min-h-screen pt-24 pb-20 transition-colors\"><div class=\"max-w-2xl mx-auto px-4 md:px-8\"><div class=\"mb-12\"><div class=\"h-1.5 w-16 bg-gradient-to-r from-brand-warm-gray to-brand-off-white rounded-full mb-6\"></div><span class=\"inline-block font-body text-xs font-semibold bg-brand-gold text-brand-black px-3 py-1 rounded-full mb-4\">Marketing Automation</span><h1 class=\"font-heading font-bold text-3xl md:text-4xl text-brand-text dark:text-white leading-tight mb-4 tracking-tight\">The 7-Step LinkedIn Strategy That Gravity Runs For You (That Would Take You 8 Hours/Week)</h1><div class=\"flex items-center gap-3 font-body text-sm text-brand-muted dark:text-white/40\"><span>Nebulaa Team</span><span>·</span><span>March 5, 2026</span><span>·</span><span>7 min read</span></div></div><div class=\"prose-nebulaa\"><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">title: &quot;The 7-Step LinkedIn Strategy That Gravity Runs For You&quot;</p><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">category: &quot;Marketing Automation&quot;</p><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">date: &quot;March 5, 2026&quot;</p><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">readTime: &quot;7 min read&quot;</p><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">author: &quot;Nebulaa Team&quot;</p><div class=\"my-3\"></div><h1 class=\"font-heading text-3xl font-bold text-brand-text dark:text-white mt-10 mb-4 tracking-tight\">The 7-Step LinkedIn Strategy That Gravity Runs For You (That Would Take You 8 Hours/Week)</h1><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Most founders know they should be posting on LinkedIn. Almost none of them actually do it consistently. The reason isn&#x27;t laziness — it&#x27;s the invisible cost of the creative process.</p><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Writing one post doesn&#x27;t take 5 minutes. It takes 40. There&#x27;s research, drafting, second-guessing, editing, formatting, scheduling. Do that three times a week and you&#x27;ve spent 2 hours you didn&#x27;t have.</p><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Gravity solves this. Here&#x27;s exactly how.</p><div class=\"my-3\"></div><h2 class=\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\">Step 1: Brand Voice Ingestion (Done Once)</h2><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">The first thing Gravity does is read your website. Every page — home, about, product, blog. It extracts:</p><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">Your vocabulary and tone</p></div><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">The specific problems you solve</p></div><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">The audience you write for</p></div><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">How you talk about competitors</p></div><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">This takes about 60 seconds. After this, Gravity doesn&#x27;t just know what you do. It writes like you.</p><div class=\"my-3\"></div><h2 class=\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\">Step 2: ICP Mapping</h2><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Next, Gravity identifies your Ideal Customer Profile from your existing content. It cross-references this with LinkedIn audience data to understand what content format converts for your segment:</p><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">Founders → story-driven, insight posts</p></div><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">Marketers → tactical, framework posts</p></div><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">SMB owners → result-driven, case-study posts</p></div><div class=\"my-3\"></div><h2 class=\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\">Step 3: Competitor Intelligence</h2><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Gravity tracks the top 3 competitors you identify (or discovers them automatically from your website). Every day, it notes what they&#x27;re posting, what topics they&#x27;re targeting, and where there are content gaps.</p><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">This feeds the content calendar automatically.</p><div class=\"my-3\"></div><h2 class=\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\">Step 4: The Daily Content Queue</h2><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Every morning, Gravity generates 3 posts:</p><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">1 thought leadership piece (LinkedIn long-form)</p></div><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">1 short-form hook (Twitter/X thread starter)</p></div><div class=\"flex items-start gap-2 my-1.5\"><span class=\"text-brand-gold mt-1 flex-shrink-0\">•</span><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\">1 visual caption (Instagram)</p></div><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Each post is uniquely written. No templates, no fill-in-the-blanks.</p><div class=\"my-3\"></div><h2 class=\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\">Step 5: Festival &amp; Trend Layer</h2><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Indian founders know that content tied to cultural moments performs significantly better. Budget Day analysis. IPL take. Diwali campaign. Gravity has a built-in calendar of 80+ Indian cultural moments per year and drafts content for each one — 3 days in advance.</p><div class=\"my-3\"></div><h2 class=\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\">Step 6: Scheduling and Publishing</h2><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Once posts are in the queue, Gravity handles the rest. Optimal posting times are calculated per platform based on your audience&#x27;s activity. Posts go live automatically. You get a morning summary of what went live.</p><div class=\"my-3\"></div><h2 class=\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\">Step 7: Performance Learning</h2><div class=\"my-3\"></div><p class=\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\">Over time, Gravity learns which of your posts get the most engagement and adjusts the content style accordingly. The longer you use it, the better it gets.</p><div class=\"my-3\"></div><div class=\"my-3\"></div><p class=\"font-body text-sm text-brand-muted dark:text-white/50 italic my-2\">Want to see Gravity write your first 7 days of LinkedIn content? Start your free trial — no card needed.</p><div class=\"my-3\"></div></div><div class=\"mt-14 bg-[#F9F6EE] dark:bg-[#111110] border border-brand-border dark:border-white/8 rounded-2xl p-6\"><div class=\"flex items-start gap-4\"><div class=\"flex-1\"><h3 class=\"font-heading text-lg font-bold text-brand-text dark:text-white mb-1\">Get GTM playbooks that actually work</h3><p class=\"font-body text-sm text-brand-muted dark:text-white/50 mb-4\">One email a week. Actionable tips for founders building in India. No fluff, no spam — ever.</p><form class=\"flex flex-col sm:flex-row gap-2\"><input type=\"text\" placeholder=\"Your name\" class=\"flex-1 border border-brand-border dark:border-white/10 dark:bg-white/5 dark:text-white rounded-xl px-4 py-2.5 font-body text-sm outline-none focus:border-brand-gold transition-colors placeholder:text-brand-muted dark:placeholder:text-white/30\" value=\"\"/><input type=\"email\" placeholder=\"your@email.com\" required=\"\" class=\"flex-1 border border-brand-border dark:border-white/10 dark:bg-white/5 dark:text-white rounded-xl px-4 py-2.5 font-body text-sm outline-none focus:border-brand-gold transition-colors placeholder:text-brand-muted dark:placeholder:text-white/30\" value=\"\"/><button type=\"submit\" disabled=\"\" class=\"bg-brand-gold text-brand-black font-body font-semibold rounded-xl px-5 py-2.5 text-sm hover:bg-brand-gold-dim transition-all disabled:opacity-60 whitespace-nowrap\">Join free →</button></form><p class=\"font-body text-xs text-brand-muted dark:text-white/30 mt-2\">Unsubscribe anytime.</p></div></div></div><div class=\"mt-8 bg-brand-gold-pale dark:bg-brand-gold/8 border border-brand-gold/20 dark:border-brand-gold/15 rounded-2xl p-6 text-center\"><h3 class=\"font-heading text-lg font-bold text-brand-text dark:text-white mb-2\">Ready to automate your GTM?</h3><p class=\"font-body text-sm text-brand-muted dark:text-white/50 mb-4\">100 free credits. No card required. Setup in 24 hours.</p><a href=\"/pricing\" class=\"inline-flex items-center gap-2 bg-brand-gold text-brand-black font-body font-semibold rounded-full px-6 py-3 hover:bg-brand-gold-dim transition-all hover:scale-[1.03]\">Start your free trial →</a></div><div class=\"mt-8 text-center\"><a href=\"/blog\" class=\"font-body text-sm text-brand-muted dark:text-white/30 hover:text-brand-gold dark:hover:text-brand-gold transition-colors\">← Back to all posts</a></div></div></main><footer class=\"relative border-t border-rule pt-[60px] pb-[50px] px-6 md:px-12 lg:px-[120px]\"><div class=\"flex flex-col lg:flex-row items-start justify-between gap-[50px] lg:gap-[70px]\"><div><div class=\"flex items-center gap-[10px] mb-4\"><div class=\"w-[17px] h-[17px] rounded-full flex-shrink-0\" style=\"background:radial-gradient(circle at 34% 32%, #FFD48A 0%, #F5A623 46%, #A4650B 100%)\"></div><span class=\"font-heading text-[17px] font-normal text-ink\">Nebulaa</span></div><div class=\"font-body text-[13px] text-muted leading-[1.7]\">Chennai, India<br/><a href=\"mailto:hello@nebulaa.ai\" class=\"hover:text-gold-text transition-colors\">hello@nebulaa.ai</a></div></div><div class=\"flex flex-wrap gap-x-[70px] gap-y-[40px]\"><div class=\"flex flex-col gap-[11px]\"><span class=\"neb-label  mb-1\">Product</span><a href=\"/product\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Overview</a><a href=\"/product/gravity\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Gravity</a><a href=\"/product/pulsar\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Pulsar</a><a href=\"/pricing\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Pricing</a></div><div class=\"flex flex-col gap-[11px]\"><span class=\"neb-label  mb-1\">Services</span><a href=\"/services\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Managed services</a><a href=\"/channels\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Channels</a><a href=\"/work\" class=\"font-body text-[13.5px] text-muted hover:text-ink trans