lassName\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Trial Management: To manage your free trial period, track eligibility, and communicate about trial expiry and upgrade options\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Billing & Payments: To process your Subscription payments, generate invoices, manage renewals, and comply with GST and financial record-keeping obligations\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Customer Support: To respond to your queries, troubleshoot issues, and provide assistance\"}]]}],[\"$\",\"li\",\"5\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Platform Improvement: To analyse usage patterns, identify bugs, improve AI model performance, and develop new features\"}]]}],[\"$\",\"li\",\"6\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Communications: To send you service-related notices, product updates, security alerts, and — where you have opted in — marketing communications\"}]]}],[\"$\",\"li\",\"7\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Legal Compliance: To comply with applicable Indian laws, regulations, and court or regulatory orders\"}]]}],[\"$\",\"li\",\"8\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Safety & Security: To detect, prevent, and investigate fraud, abuse, security incidents, and violations of our Terms\"}]]}]]}],[\"$\",\"p\",null,{\"children\":\"Legal bases under Indian law (Information Technology Act, 2000; IT (Reasonable Security Practices and Procedures and Sensitive Personal Data or Information) Rules, 2011; and the Digital Personal Data Protection Act, 2023, upon its notification): your consent; performance of a contract with you; compliance with a legal obligation; and legitimate interests pursued by us or a third party.\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":4}],\"How We Use Your Data\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[[\"$\",\"p\",null,{\"children\":\"In addition to the purposes above, we use your data to:\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Personalise your experience and surface relevant recommendations through our AI models\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Conduct aggregate, anonymised analysis and research to improve the Platform's decision feedback capabilities\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Train and improve AI/ML models, using anonymised and de-identified data only, unless you provide explicit consent for identifiable data use\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Enforce our Terms & Conditions and other policies\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Protect the rights, property, and safety of the Company, our users, and the public\"}]]}]]}],[\"$\",\"p\",null,{\"children\":\"We will not sell your personal data to third parties. We will not use your personal data for advertising or marketing purposes by third parties without your explicit consent.\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":5}],\"Data Sharing & Disclosure\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We do not sell, rent, or trade your personal data. We may share your data in the following limited circumstances:\"}],[\"$\",\"h3\",null,{\"className\":\"font-body font-bold text-brand-text dark:text-white/90 mt-5 mb-2\",\"children\":\"5.1 Service Providers\"}],[\"$\",\"p\",null,{\"children\":\"We engage trusted third-party vendors to support our operations, including cloud hosting and infrastructure providers, Razorpay (payment processing), analytics services, email and communication service providers, and AI/ML infrastructure providers. All service providers are bound by data processing agreements.\"}],[\"$\",\"h3\",null,{\"className\":\"font-body font-bold text-brand-text dark:text-white/90 mt-5 mb-2\",\"children\":\"5.2 Legal & Regulatory Disclosure\"}],[\"$\",\"p\",null,{\"children\":\"We may disclose your data if required by applicable law, regulation, court order, or governmental authority, or to enforce our legal rights.\"}],[\"$\",\"h3\",null,{\"className\":\"font-body font-bold text-brand-text dark:text-white/90 mt-5 mb-2\",\"children\":\"5.3 Business Transfers\"}],[\"$\",\"p\",null,{\"children\":\"In the event of a merger, acquisition, restructuring, or sale of all or part of our business, your data may be transferred to the successor entity. You will be notified of any such transfer and your rights therein.\"}],[\"$\",\"h3\",null,{\"className\":\"font-body font-bold text-brand-text dark:text-white/90 mt-5 mb-2\",\"children\":\"5.4 With Your Consent\"}],[\"$\",\"p\",null,{\"children\":\"We may share your data with third parties when you have explicitly consented to such sharing.\"}],[\"$\",\"h3\",null,{\"className\":\"font-body font-bold text-brand-text dark:text-white/90 mt-5 mb-2\",\"children\":\"5.5 Aggregated & Anonymised Data\"}],[\"$\",\"p\",null,{\"children\":\"We may share aggregated, anonymised, or de-identified data that cannot reasonably identify you, for research, analytics, or commercial purposes.\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":6}],\"Data Retention\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[[\"$\",\"ul\",null,{\"className\":\"space-y-1.5\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Active account data: Retained for the duration of your Subscription plus 2 years post-termination for legal and audit purposes\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Trial data: Retained for 90 days post-trial expiry if you do not convert to a paid plan, after which it is deleted or anonymised\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Financial and billing records: Retained for 7 years as required under Indian tax and accounting laws\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Usage logs and analytics: Retained for up to 24 months, after which they are anonymised\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Support communications: Retained for 3 years from the date of last communication\"}]]}]]}],[\"$\",\"p\",null,{\"children\":\"You may request deletion of your data at any time (see Section 9). We will comply subject to our legal retention obligations.\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":7}],\"Data Security\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We implement appropriate technical and organisational measures to protect your personal data. These measures include:\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Encryption of data in transit using TLS/SSL protocols\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Encryption of sensitive data at rest\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Access controls limiting data access to authorised personnel only\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Regular security assessments and vulnerability testing\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Incident response procedures for security breaches\"}]]}]]}],[\"$\",\"p\",null,{\"children\":\"In the event of a personal data breach that poses a risk to your rights, we will notify you and relevant authorities as required by applicable law. However, no system can guarantee absolute security.\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":8}],\"Data Transfers\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[\"$\",\"p\",null,{\"children\":\"Nebulaa is primarily operated from India. Your data may be processed or stored on servers located in India or in other jurisdictions where our service providers operate. Where data is transferred outside India, we ensure appropriate safeguards are in place, consistent with applicable Indian data protection law and the requirements of the Digital Personal Data Protection Act, 2023.\"}]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":9}],\"Your Rights\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Subject to applicable law, you have the following rights with respect to your personal data:\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Right to Access: Request a copy of the personal data we hold about you\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Right to Correction: Request correction of inaccurate or incomplete personal data\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Right to Erasure: Request deletion of your personal data, subject to our legal retention obligations\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Right to Portability: Request your data in a structured, machine-readable format\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Right to Withdraw Consent: Withdraw consent at any time where processing is based on consent\"}]]}],[\"$\",\"li\",\"5\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Right to Object: Object to processing based on legitimate interests, including for direct marketing\"}]]}],[\"$\",\"li\",\"6\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Right to Restrict Processing: Request that we limit how we use your data in certain circumstances\"}]]}],[\"$\",\"li\",\"7\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Right to Grievance Redressal: Lodge a complaint with our Grievance Officer (see Section 12)\"}]]}]]}],[\"$\",\"p\",null,{\"children\":[\"To exercise any of these rights, please contact us at \",[\"$\",\"a\",null,{\"href\":\"mailto:privacy@nebulaa.ai\",\"className\":\"text-brand-gold hover:underline\",\"children\":\"privacy@nebulaa.ai\"}],\". We will respond within 30 days.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":10}],\"Cookies & Tracking Technologies\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We use cookies, web beacons, local storage, and similar technologies to enhance your experience, analyse usage, and maintain your session.\"}],[\"$\",\"h3\",null,{\"className\":\"font-body font-bold text-brand-text dark:text-white/90 mt-5 mb-2\",\"children\":\"Types of cookies we use:\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Essential cookies: Required for the Platform to function correctly (e.g., session management, authentication)\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Analytical cookies: Used to understand how users interact with the Platform and improve its features\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Preference cookies: Used to remember your settings and personalisation choices\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-brand-gold mt-1 flex-shrink-0\",\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Marketing cookies: Used only with your prior consent to deliver relevant communications\"}]]}]]}],[\"$\",\"p\",null,{\"children\":\"You can control cookies through your browser settings. By using the Platform, you consent to our use of cookies as described herein.\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":11}],\"Children's Privacy\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[\"$\",\"p\",null,{\"children\":[\"The Nebulaa Platform is intended for business users and is not directed at individuals under the age of 18. We do not knowingly collect personal data from minors. If you believe we have inadvertently collected data from a minor, please contact us immediately at \",[\"$\",\"a\",null,{\"href\":\"mailto:privacy@nebulaa.ai\",\"className\":\"text-brand-gold hover:underline\",\"children\":\"privacy@nebulaa.ai\"}],\".\"]}]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading font-bold text-xl text-brand-text dark:text-white mb-4 flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 text-brand-gold text-sm font-bold flex items-center justify-center\",\"children\":12}],\"Grievance Officer\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-brand-muted dark:text-white/70 font-body text-sm leading-relaxed pl-11\",\"children\":[[\"$\",\"p\",null,{\"children\":\"In accordance with the Information Technology Act, 2000 and applicable rules, we have appointed a Grievance Officer to address privacy-related concerns:\"}],[\"$\",\"div\",null,{\"className\":\"bg-brand-gold/5 dark:bg-white/5 border border-brand-gold/15 rounded-xl p-4 space-y-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-brand-muted dark:text-white/70\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-semibold text-brand-text dark:text-white\",\"children\":\"Grievance Officer:\"}],\" Navaneetha Krishnan\"]}],[\"$\",\"p\",null,{\"className\":\"text-brand-muted dark:text-white/70\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-semibold text-brand-text dark:text-white\",\"children\":\"Organisation:\"}],\" Noburo Business Services LLP (Nebulaa)\"]}],[\"$\",\"p\",null,{\"className\":\"text-brand-muted dark:text-white/70\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-semibold text-brand-text dark:text-white\",\"children\":\"Email:\"}],\" \",[\"$\",\"a\",null,{\"href\":\"mailto:support@nebulaa.ai\",\"className\":\"text-brand-gold hover:underline\",\"children\":\"support@ne