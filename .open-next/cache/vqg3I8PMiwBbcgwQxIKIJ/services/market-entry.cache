s\",\"children\":\"02\"}],[\"$\",\"h3\",null,{\"className\":\"font-heading font-medium text-[19px] mb-2.5\",\"children\":\"Build awareness first\"}],[\"$\",\"p\",null,{\"className\":\"text-[14.5px] leading-[1.65] text-muted\",\"children\":\"Local content, creators and geo-targeted campaigns run in the months before anything is on a shelf.\"}]]}],[\"$\",\"div\",\"Layer in trial and availability\",{\"className\":\"border-t border-gold/30 pt-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-heading text-[22px] text-gold-text mb-3 tabular-nums\",\"children\":\"03\"}],[\"$\",\"h3\",null,{\"className\":\"font-heading font-medium text-[19px] mb-2.5\",\"children\":\"Layer in trial and availability\"}],[\"$\",\"p\",null,{\"className\":\"text-[14.5px] leading-[1.65] text-muted\",\"children\":\"Sampling and retail activation as launch approaches, timed to when stock actually lands.\"}]]}],[\"$\",\"div\",\"Convert at launch\",{\"className\":\"border-t border-gold/30 pt-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-heading text-[22px] text-gold-text mb-3 tabular-nums\",\"children\":\"04\"}],[\"$\",\"h3\",null,{\"className\":\"font-heading font-medium text-[19px] mb-2.5\",\"children\":\"Convert at launch\"}],[\"$\",\"p\",null,{\"className\":\"text-[14.5px] leading-[1.65] text-muted\",\"children\":\"By launch week the brand is familiar, the listings are live, and the activation is already running.\"}]]}]]}]]}],[[\"$\",\"hr\",null,{\"className\":\"border-t border-rule\"}],[\"$\",\"section\",null,{\"className\":\"px-6 md:px-12 lg:px-[120px] py-[100px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-[660px] mb-[52px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"neb-label neb-label-gold mb-[20px] block\",\"children\":\"The sequence\"}],[\"$\",\"h2\",null,{\"className\":\"font-heading font-medium text-[30px] md:text-[42px] leading-[1.14] tracking-[-0.02em] mb-4\",\"children\":[\"Four months to \",[\"$\",\"span\",null,{\"className\":\"italic text-gold-text\",\"children\":\"a launch that lands.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[16px] leading-[1.68] text-muted\",\"children\":\"Working backwards from the date, so demand is already in place when the stock is.\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-px bg-rule border border-rule rounded-[18px] overflow-hidden\",\"children\":[[\"$\",\"div\",\"Month 1\",{\"className\":\"bg-surface grid md:grid-cols-[160px_minmax(0,1fr)] gap-x-8 gap-y-3 px-6 md:px-9 py-7\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"neb-label neb-label-gold mb-1.5\",\"children\":\"Month 1\"}],[\"$\",\"div\",null,{\"className\":\"font-heading font-medium text-[19px]\",\"children\":\"Build the market\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[15px] leading-[1.65] text-muted mb-3\",\"children\":\"City-focused campaigns begin, a local audience starts forming, relevant creators are identified, quick-commerce availability is mapped and priority retail clusters are agreed.\"}],[\"$\",\"p\",null,{\"className\":\"text-[14px] leading-[1.6] text-ink-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-gold-text font-semibold\",\"children\":\"Outcome — \"}],\"People in the city begin encountering the brand before launch.\"]}]]}]]}],[\"$\",\"div\",\"Month 2\",{\"className\":\"bg-surface grid md:grid-cols-[160px_minmax(0,1fr)] gap-x-8 gap-y-3 px-6 md:px-9 py-7\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"neb-label neb-label-gold mb-1.5\",\"children\":\"Month 2\"}],[\"$\",\"div\",null,{\"className\":\"font-heading font-medium text-[19px]\",\"children\":\"Build product interest\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[15px] leading-[1.65] text-muted mb-3\",\"children\":\"Product-focused communication increases, creator collaborations go live, quick-commerce discovery activity starts and sampling begins in priority areas.\"}],[\"$\",\"p\",null,{\"className\":\"text-[14px] leading-[1.6] text-ink-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-gold-text font-semibold\",\"children\":\"Outcome — \"}],\"Consumers move from \\\"I have seen this brand\\\" to \\\"I want to try it.\\\"\"]}]]}]]}],[\"$\",\"div\",\"Month 3\",{\"className\":\"bg-surface grid md:grid-cols-[160px_minmax(0,1fr)] gap-x-8 gap-y-3 px-6 md:px-9 py-7\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"neb-label neb-label-gold mb-1.5\",\"children\":\"Month 3\"}],[\"$\",\"div\",null,{\"className\":\"font-heading font-medium text-[19px]\",\"children\":\"Create purchase intent\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[15px] leading-[1.65] text-muted mb-3\",\"children\":\"Performance campaigns intensify, offer communication goes out, traffic is driven to live listings, and sampling and BTL step up as distribution readiness completes.\"}],[\"$\",\"p\",null,{\"className\":\"text-[14px] leading-[1.6] text-ink-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-gold-text font-semibold\",\"children\":\"Outcome — \"}],\"Demand is being created while availability is being put in place.\"]}]]}]]}],[\"$\",\"div\",\"Month 4\",{\"className\":\"bg-surface grid md:grid-cols-[160px_minmax(0,1fr)] gap-x-8 gap-y-3 px-6 md:px-9 py-7\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"neb-label neb-label-gold mb-1.5\",\"children\":\"Month 4\"}],[\"$\",\"div\",null,{\"className\":\"font-heading font-medium text-[19px]\",\"children\":\"Launch and convert\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[15px] leading-[1.65] text-muted mb-3\",\"children\":\"The brand is visible across digital, creators keep recommending, listings are promoted where available, and retail activation supports the launch on the ground.\"}],[\"$\",\"p\",null,{\"className\":\"text-[14p