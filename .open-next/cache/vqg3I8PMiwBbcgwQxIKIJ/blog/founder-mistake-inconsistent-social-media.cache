\\\":\\\"mb-12\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"h-1.5 w-16 bg-gradient-to-r from-pink-500/20 to-pink-400/5 rounded-full mb-6\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"inline-block font-body text-xs font-semibold bg-brand-gold text-brand-black px-3 py-1 rounded-full mb-4\\\",\\\"children\\\":\\\"Founder Mistakes\\\"}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"font-heading font-bold text-3xl md:text-4xl text-brand-text dark:text-white leading-tight mb-4 tracking-tight\\\",\\\"children\\\":\\\"Why Inconsistent Social Media Is Costing You More Than You Think\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-body text-sm text-brand-muted dark:text-white/40\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Nebulaa Team\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"·\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"February 15, 2026\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"·\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"5 min read\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose-nebulaa\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"title: \\\\\\\"Why Inconsistent Social Media Is Costing You More Than You Think\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"category: \\\\\\\"Founder Mistakes\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"date: \\\\\\\"February 15, 2026\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"readTime: \\\\\\\"5 min read\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"author: \\\\\\\"Nebulaa Team\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"5\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h1\\\",\\\"6\\\",{\\\"className\\\":\\\"font-heading text-3xl font-bold text-brand-text dark:text-white mt-10 mb-4 tracking-tight\\\",\\\"children\\\":\\\"Why Inconsistent Social Media Is Costing You More Than You Think\\\"}],[\\\"$\\\",\\\"div\\\",\\\"7\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"You post 3 times in a week when you're feeling motivated. Then nothing for three weeks because a product issue blew up and content fell to the bottom of the list. Then a burst of 4 posts in 2 days when you feel guilty about going quiet.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"9\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Sound familiar? This pattern is more common than consistent posting — and it's doing measurable damage to your business that most founders completely underestimate.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"11\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"12\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"What the Algorithm Actually Does to Inconsistent Accounts\\\"}],[\\\"$\\\",\\\"div\\\",\\\"13\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"14\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"LinkedIn's algorithm is not random. It rewards accounts that publish on a predictable cadence because consistent publishers are more valuable to the platform than sporadic ones.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"15\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Here's what happens mechanically when you go silent for 3 weeks:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"17\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"18\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"1. Your engagement rate drops in the platform's model (recent posts = less interaction = lower engagement score)\\\"}],[\\\"$\\\",\\\"p\\\",\\\"19\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"2. Your next post starts with a reduced distribution baseline — LinkedIn shows it to fewer people than it would have if you'd been active\\\"}],[\\\"$\\\",\\\"p\\\",\\\"20\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"3. It takes 2–3 consistent weeks of posting again just to recover to where you were\\\"}],[\\\"$\\\",\\\"div\\\",\\\"21\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"22\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"So that one post you finally publish after a 3-week gap? It gets seen by maybe 40% of the audience your posts were reaching before. You have to earn your way back every time.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"23\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"24\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Trust Signal Your Potential Customers Are Reading\\\"}],[\\\"$\\\",\\\"div\\\",\\\"25\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"26\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Here's the part most founders miss: your potential customers are not passive. Before they book a demo, sign up for a trial, or reply to your cold outreach, many of them check your LinkedIn profile.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"27\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"28\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"What they see when they visit an inconsistent profile:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"29\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"30\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Last post: 3 weeks ago\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"31\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Post before that: 4 weeks before that\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"32\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"8 posts in the last 6 months\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"33\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"34\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"What they read from this: \\\\\\\"This company might not be around next year. The founder seems busy and distracted. This doesn't feel like a serious operation.\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"35\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"36\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"That's harsh. But that's the signal. Your content cadence is a proxy for company health in the minds of early-adopter B2B buyers. Founders who post regularly feel like they have momentum. Founders who post erratically feel like they're struggling.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"37\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"38\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Real Cost (In Numbers)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"39\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"40\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Let's put some rough numbers on this. Assume your LinkedIn content drives:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"41\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"42\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"3 warm inbound leads per month when you're posting consistently\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"43\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"0.5 warm leads per month when you're in a posting gap\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"44\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"45\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Over a 12-month period with 4 months of gaps (which is conservative for most founders): you generate roughly 24 leads instead of 36. That's 12 leads you never got.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"46\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"47\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"If your average deal size is ₹1.5L and you close 1 in 4 leads: that's 3 deals, or ₹4.5L in revenue that the inconsistency cost you.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"48\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"49\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Most founders spend ₹4.5L on a lot of things — ads, events, tooling — and never think to measure the cost of their inconsistent content habit.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"50\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"51\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Why Founders Go Inconsistent (It's Not Laziness)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"52\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"53\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"The pattern is always the same. A product crisis, a fundraising sprint, a team issue, or just a genuinely hectic month means content falls off the list. After a few weeks of silence, the psychological barrier to \\\\\\\"getting back on track\\\\\\\" gets higher. The longer you wait, the worse it feels to start again.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"54\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"55\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"It's not a discipline problem. It's an infrastructure problem.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"56\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"57\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Founders who post consistently don't have more time or more discipline. They've either built a system or hired someone to run the system. The most common system: an AI agent that generates, schedules, and posts on their behalf — requiring only 15–20 minutes of review per week.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"58\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"59\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"How to Break the Cycle\\\"}],[\\\"$\\\",\\\"div\\\",\\\"60\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"61\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"The fix is not motivation. Motivation is unreliable. The fix is removing the activation energy from the process.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"62\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"63\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"If posting requires you to have a good idea, write it out, edit it, find the right format, and schedule it — you'll skip it on any hard day. That's most days.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"64\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"65\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"If posting requires you to open an app, review what's already been written for you, and tap approve — you'll do it even on hard days.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"66\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"67\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Gravity is built for exactly this. It generates your content queue every week based on your brand voice, your industry, and what's working in your category. You spend 15 minutes reviewing. It handles the rest.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"68\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"69\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"The result: your LinkedIn stays active regardless of how your week is going. Your audience grows. Your leads come in even when you're in a crunch.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"70\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"71\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"72\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Key Takeaways\\\"}],[\\\"$\\\",\\\"div\\\",\\\"73\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"74\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Inconsistent posting triggers algorithmic penalties that take weeks to recover from\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"75\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Potential customers read your posting cadence as a signal of company health\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"76\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"4 months of gaps in a year could cost ₹4L+ in missed revenue (depending on deal size)\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"77\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"The fix is infrastructure, not motivation — remove the activation energy from the process\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"78\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"79\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"80\\\",{\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/50 italic my-2\\\",\\\"children\\\":\\\"Gravity keeps your content live every day, even when you're heads-down. [Start your free 7-day trial →](/)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"81\\\",{\\\"className\\\":\\\"my-3\\\"}]]}],[\\\"$\\\",\\\"$Le\\\",null,{}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 bg-brand-gold-pale dark:bg-brand-gold/8 border border-brand-gold/20 dark:border-brand-gold/15 rounded-2xl p-6 text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-heading text-lg font-bold text-brand-text dark:text-white mb-2\\\",\\\"children\\\":\\\"Ready to automate your GTM?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/50 mb-4\\\",\\\"children\\\":\\\"100 free credits. No card required. Setup in 24 hours.\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/pricing\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 bg-brand-gold text-brand-black font-body font-semibold rounded-full px-6 py-3 hover:bg-brand-gold-dim transition-all hover:scale-[1.03]\\\",\\\"children\\\":\\\"Start your free trial →\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 text-center\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/30 hover:text-brand-gold dark:hover:text-brand-gold transition-colors\\\",\\\"children\\\":\\\"← Back to all posts\\\"}]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"b:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach Agents for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated. Gravity posts, Pulsar calls. Built for Indian founders and SMBs. Start free — 100 credits, no card.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"link\\\",\\\"6\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Nebulaa.ai — Your GTM Team Just Showed Up\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Gravity posts. Pulsar calls. You close.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"property\\\":\\\"og:site_name\\\",\\\"content\\\":\\\"Nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"en_IN\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"name\\\":\\\"twitter:site\\\",\\\"content\\\":\\\"@nebulaaai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated.\\\"}],[\\\"$\\\",\\\"link\\\",\\\"17\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n3:null\\n\"])</script></body></html>","rsc":"3:I[4707,[],\"\"]\n5:I[6423,[],\"\"]\n7:I[2144,[\"972\",\"static/chunks/972-8c0ee6fabcd1342f.js\",\"309\",\"static/chunks/309-526a3bc2ba734d25.js\",\"878\",\"static/chunks/878-ed980f2cac33ad8c.js\",\"739\",\"static/chunks/739-3ece649a7e02ff75.js\",\"185\",\"static/chunks/app/layout-5a72189eaa6243d0.js\"],\"default\"]\n8:I[6194,[\"972\",\"static/chunks/972-8c0ee6fabcd1342f.js\",\"309\",\"static/chunks/309-526a3bc2ba734d25.js\",\"878\",\"static/chunks/878-ed980f2cac33ad8c.js\",\"739\",\"static/chunks/739-3ece649a7e02ff75.js\",\"185\",\"static/chunks/app/layout-5a72189eaa6243d0.js\"],\"default\"]\n4:[\"slug\",\"founder-mistake-inconsistent-social-media\",\"d\"]\n6:T5c5,{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"legalName\":\"Noburo Business Services LLP\",\"url\":\"https://nebulaa.ai\",\"email\":\"hello@nebulaa.ai\",\"description\":\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\",\"foundingDate\":\"2025\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressRegion\":\"Tamil Nadu\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"},\"makesOffer\":[{\"@type\":\"Offer\",\"name\":\"Gravity\",\"price\":\"10000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Gravity\",\"description\":\"Reads a website and builds a marketing strategy from it, plans the month, drafts posts, carousels and reels, tracks competitors, runs campaigns and creator collaborations, and handles the social inbox.\"}},{\"@type\":\"Offer\",\"name\":\"Pulsar\",\"price\":\"15000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Pulsar\",\"description\":\"Answers enquiries on WhatsApp, email and SMS within minutes, qualifies budget, timeline and fit, scores every lead, and runs broadcasts, automation and voice calling.\"}},{\"@type\":\"Offer\",\"name\":\"Both agents\",\"price\":\"20000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Both agents\",\"description\":\"Gravity and Pulsar on one account, sharing the same brand memory.\"}}]}0:[\"vqg3I8PMiwBbcgwQxIKIJ\",[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"founder-mistake-inconsistent-social-media\",\"d\"],{\"children\":[\"__PAGE__?{\\\"slug\\\":\\\"founder-mistake-inconsistent-social-media\\\"}\",{}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"founder-mistake-inconsistent-social-media\",\"d\"],{\"children\":[\"__PAGE__\",{},[[\"$L1\",\"$L2\",null],null],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\",\"$4\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\"}]],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\"}]],null]},[[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/91d486bf57bf1762.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://fonts.googleapis.com\"}],[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://fonts.gstatic.com\",\"crossOrigin\":\"anonymous\"}],[\"$\",\"link\",null,{\"href\":\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&