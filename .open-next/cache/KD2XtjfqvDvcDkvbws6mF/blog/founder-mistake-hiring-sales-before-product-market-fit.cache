\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Nebulaa Team\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"·\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"February 20, 2026\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"·\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"6 min read\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose-nebulaa\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"title: \\\\\\\"The Mistake 80% of Founders Make: Hiring Sales Before Product-Market Fit\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"category: \\\\\\\"Founder Mistakes\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"date: \\\\\\\"February 20, 2026\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"readTime: \\\\\\\"6 min read\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"author: \\\\\\\"Nebulaa Team\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"5\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h1\\\",\\\"6\\\",{\\\"className\\\":\\\"font-heading text-3xl font-bold text-brand-text dark:text-white mt-10 mb-4 tracking-tight\\\",\\\"children\\\":\\\"The Mistake 80% of Founders Make: Hiring Sales Before Product-Market Fit\\\"}],[\\\"$\\\",\\\"div\\\",\\\"7\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"You close your first 5 customers. They're happy. They're paying. One of them even referred a friend.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"9\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Your brain immediately goes to: \\\\\\\"This is working. I need to scale this. I need a sales team.\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"11\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"You post a job listing for a Business Development Manager. You hire someone with a \\\\\\\"proven track record\\\\\\\" and a confident handshake. You give them a target of 20 customers in 3 months.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"13\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"14\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Three months later, they've closed 2. They're frustrated. You're frustrated. You spend ₹6L on a salary and learn almost nothing.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"15\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"This is the most common, most expensive, and most avoidable mistake in the 0–1 phase of building a startup.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"17\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"18\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Why Your First 5 Customers Don't Mean What You Think\\\"}],[\\\"$\\\",\\\"div\\\",\\\"19\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"20\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Your first 5 customers came to you because of you — your network, your hustle, your ability to demo and customise and hand-hold on the spot. You could read the room. You could pivot the pitch mid-call. You could solve problems that weren't in the product yet by promising to build them.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"21\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"22\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"A salesperson cannot do any of that. They don't have your contextual knowledge. They can't make product decisions. They can't tell when a customer's objection is a pricing issue vs a product-fit issue vs a \\\\\\\"I just need one more push\\\\\\\" issue.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"23\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"24\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"When you hire sales before PMF, you're asking someone to sell a product that isn't repeatable yet, to a segment you haven't fully defined, using a pitch that worked when you did it personally but doesn't transfer.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"25\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"26\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"The result is always the same: poor close rates, high cost, and — worst of all — you stop learning directly from customers because you've delegated that interaction.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"27\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"28\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Real Job Before PMF: Founder-Led Sales\\\"}],[\\\"$\\\",\\\"div\\\",\\\"29\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"30\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Before PMF, sales is a research function. Every customer conversation should be teaching you something:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"31\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"32\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Which problem is actually the trigger for buying?\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"33\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Which objection comes up every single time?\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"34\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Which customer segment closes fastest?\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"35\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"What's the one feature they ask about before signing?\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"36\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"37\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"You can only do this research if you're in the call. A hired SDR will follow a script. They'll qualify and disqualify based on a checklist. They won't notice the nuance that changes your entire go-to-market strategy.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"38\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"39\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Founder-led sales isn't a grind you endure until you can afford to delegate. It's intelligence gathering that no one else can do.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"40\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"41\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"3 Signs You're Actually Ready to Hire Sales\\\"}],[\\\"$\\\",\\\"div\\\",\\\"42\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"43\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"1. **You can write down exactly why a customer buys.** Not \\\\\\\"they like the product.\\\\\\\" Specifically: \\\\\\\"ops leads at 50–200 person logistics companies buy within 2 weeks when they've just had a shipment delay incident and have a board review coming up.\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"44\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"45\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"2. **Your close rate is consistent.** If you're closing 1 in 4 qualified demos, and that ratio has held across 10+ demos, you have a repeatable process worth handing to someone else.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"46\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"47\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"3. **The sales cycle is documented.** You know the steps, the objections, the collateral needed at each stage, and what \\\\\\\"qualified\\\\\\\" actually means. If you can't write this down in 30 minutes, you're not ready.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"48\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"49\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"If you can't tick all three boxes, hiring sales will not fix your pipeline problem. It will add cost and confusion to it.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"50\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"51\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"What to Do Instead: Automate the Repetitive, Keep the Human Parts Human\\\"}],[\\\"$\\\",\\\"div\\\",\\\"52\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"53\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Here's the thing — a lot of what founders do in the 0–1 phase doesn't actually require a human. The repetitive parts:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"54\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"55\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Following up with leads who didn't reply\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"56\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Sending the demo reminder\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"57\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Qualifying inbound leads before they reach you\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"58\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Sending case studies and collateral\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"59\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Making the initial outreach call\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"60\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"61\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"These can be automated. Pulsar handles exactly these tasks — so you're not spending 3 hours a day on admin that could run itself. The part that actually requires you — the live demo, the nuanced objection handling, the relationship-building — stays with you.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"62\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"63\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"You don't need to hire before PMF. You need to automate the busywork so you can do more of the high-leverage founder selling that actually teaches you something.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"64\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"65\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"The Better Sequence\\\"}],[\\\"$\\\",\\\"div\\\",\\\"66\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"67\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Before PMF: You do all the selling. Automate follow-ups, qualification, and outreach admin with tools like Pulsar.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"68\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"69\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"After PMF (10+ customers, consistent close rate, documented playbook): Hire a junior sales person and give them the playbook. Your job becomes oversight and closing the big deals.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"70\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"71\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"At scale: Build the team on top of the foundation you've actually validated.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"72\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"73\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"This sequence lets you grow faster, burn less runway, and — most importantly — learn more from every customer interaction before you've handed the keys to someone who doesn't know the product yet.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"74\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"75\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"76\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Key Takeaways\\\"}],[\\\"$\\\",\\\"div\\\",\\\"77\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"78\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Your first 5 customers came from founder-led selling — it doesn't automatically scale\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"79\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Sales hires before PMF produce poor results and stop you from learning\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"80\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"The 3 readiness signals: documented ICP, consistent close rate, written sales process\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"81\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Automate the repetitive parts (follow-up, qualification, outreach) — keep the human parts human\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"82\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"div\\\",\\\"83\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"84\\\",{\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/50 italic my-2\\\",\\\"children\\\":\\\"Pulsar handles your follow-ups and qualification so you can focus on the conversations that matter. [Start your free 7-day trial →](/)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"85\\\",{\\\"className\\\":\\\"my-3\\\"}]]}],[\\\"$\\\",\\\"$Le\\\",null,{}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 bg-brand-gold-pale dark:bg-brand-gold/8 border border-brand-gold/20 dark:border-brand-gold/15 rounded-2xl p-6 text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-heading text-lg font-bold text-brand-text dark:text-white mb-2\\\",\\\"children\\\":\\\"Ready to automate your GTM?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/50 mb-4\\\",\\\"children\\\":\\\"100 free credits. No card required. Setup in 24 hours.\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/pricing\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 bg-brand-gold text-brand-black font-body font-semibold rounded-full px-6 py-3 hover:bg-brand-gold-dim transition-all hover:scale-[1.03]\\\",\\\"children\\\":\\\"Start your free trial →\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 text-center\\\",\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"font-body text-sm text-brand-muted dark:text-white/30 hover:text-brand-gold dark:hover:text-brand-gold transition-colors\\\",\\\"children\\\":\\\"← Back to all posts\\\"}]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"b:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach Agents for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated. Gravity posts, Pulsar calls. Built for Indian founders and SMBs. Start free — 100 credits, no card.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"link\\\",\\\"6\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Nebulaa.ai — Your GTM Team Just Showed Up\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Gravity posts. Pulsar calls. You close.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"property\\\":\\\"og:site_name\\\",\\\"content\\\":\\\"Nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"en_IN\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"name\\\":\\\"twitter:site\\\",\\\"content\\\":\\\"@nebulaaai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated.\\\"}],[\\\"$\\\",\\\"link\\\",\\\"17\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n3:null\\n\"])</script></body></html>","rsc":"3:I[4707,[],\"\"]\n5:I[6423,[],\"\"]\n7:I[2144,[\"972\",\"static/chunks/972-8c0ee6fabcd1342f.js\",\"309\",\"static/chunks/309-526a3bc2ba734d25.js\",\"878\",\"static/chunks/878-ed980f2cac33ad8c.js\",\"739\",\"static/chunks/739-3ece649a7e02ff75.js\",\"185\",\"static/chunks/app/layout-5a72189eaa6243d0.js\"],\"default\"]\n8:I[6194,[\"972\",\"static/chunks/972-8c0ee6fabcd1342f.js\",\"309\",\"static/chunks/309-526a3bc2ba734d25.js\",\"878\",\"static/chunks/878-ed980f2cac33ad8c.js\",\"739\",\"static/chunks/739-3ece649a7e02ff75.js\",\"185\",\"static/chunks/app/layout-5a72189eaa6243d0.js\"],\"default\"]\n4:[\"slug\",\"founder-mistake-hiring-sales-before-product-market-fit\",\"d\"]\n6:T5c5,{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"legalName\":\"Noburo Business Services LLP\",\"url\":\"https://nebulaa.ai\",\"email\":\"hello@nebulaa.ai\",\"description\":\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\",\"foundingDate\":\"2025\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressRegion\":\"Tamil Nadu\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"},\"makesOffer\":[{\"@type\":\"Offer\",\"name\":\"Gravity\",\"price\":\"10000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Gravity\",\"description\":\"Reads a website and builds a marketing strategy from it, plans the month, drafts posts, carousels and reels, tracks competitors, runs campaigns and creator collaborations, and handles the social inbox.\"}},{\"@type\":\"Offer\",\"name\":\"Pulsar\",\"price\":\"15000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Pulsar\",\"description\":\"Answers enquiries on WhatsApp, email and SMS within minutes, qualifies budget, timeline and fit, scores every lead, and runs broadcasts, automation and voice calling.\"}},{\"@type\":\"Offer\",\"name\":\"Both agents\",\"price\":\"20000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Both agents\",\"description\":\"Gravity and Pulsar on one account, sharing the same brand memory.\"}}]}0:[\"KD2XtjfqvDvcDkvbws6mF\",[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"founder-mistake-hiring-sales-before-product-market-fit\",\"d\"],{\"children\":[\"__PAGE__?{\\\"slug\\\":\\\"founder-mistake-hiring-sales-before-product-market-fit\\\"}\",{}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"founder-mistake-hiring-sales-before-product-market-fit\",\"d\"],{\"children\":[\"__PAGE__\",{},[[\"$L1\",\"$L2\",null],null],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\",\"$4\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$