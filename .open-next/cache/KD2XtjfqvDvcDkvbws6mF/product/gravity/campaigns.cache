"className\":\"italic text-gold-display\",\"children\":\"a single post.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[17.5px] leading-[1.65] text-muted max-w-[640px] mb-9\",\"children\":\"A new collection, a festival offer, a store opening — these need a run of content that builds, not one post that disappears. Campaigns group the whole sequence, across formats and platforms, against one objective and one date.\"}],[\"$\",\"$L2\",null,{\"href\":\"/pricing\",\"className\":\"inline-flex items-center gap-2 bg-gold text-[#1A1208] text-[15px] font-semibold px-[28px] py-[14px] rounded-full hover:brightness-105 transition\",\"children\":[\"Start free trial \",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":15,\"height\":15,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"px-6 md:px-12 lg:px-[120px] pb-[90px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative rounded-[14px] border border-dashed border-rule-2 bg-surface-2/60 flex items-center justify-center p-6 \",\"style\":{\"aspectRatio\":\"16 / 10\"},\"data-media-slot\":\"gravity-campaigns\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-[46ch] text-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"neb-label neb-label-gold mb-2.5\",\"children\":[\"screenshot\",\" · awaiting asset\"]}],[\"$\",\"p\",null,{\"className\":\"font-heading text-[17px] text-ink mb-2\",\"children\":\"Gravity — campaign builder\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-[13px] leading-[1.55] text-muted mb-3\",\"children\":\"The campaign view. Currently unmarketed entirely — no page mentions campaigns exist.\"}],[\"$\",\"p\",null,{\"className\":\"font-body text-[11.5px] text-faint\",\"children\":[\"Drop \",[\"$\",\"code\",null,{\"className\":\"text-ink-2\",\"children\":\"gravity-campaigns.png\"}],\" into \",[\"$\",\"code\",null,{\"className\":\"text-ink-2\",\"children\":\"public/media/\"}],\" · \",\"2880×1800\"]}]]}]}]}],[\"$\",\"hr\",null,{\"className\":\"border-t border-rule\"}],[\"$\",\"section\",null,{\"className\":\"px-6 md:px-12 lg:px-[120px] py-[100px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-[640px] mb-[52px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"neb-label neb-label-gold mb-[20px] block\",\"children\":\"How it works\"}],[\"$\",\"h2\",null,{\"className\":\"font-heading font-medium text-[30px] md:text-[42px] leading-[1.14] tracking-[-0.02em]\",\"children\":[\"Three steps, \",[\"$\",\"span\",null,{\"className\":\"italic text-gold-text\",\"children\":\"start to finish.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid md:grid-cols-3 gap-6\",\"children\":[[\"$\",\"div\",\"Set the objective and the date\",{\"className\":\"border-t border-gold/30 pt-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-heading text-[22px] text-gold-text mb-3 tabular-nums\",\"children\":\"01\"}],[\"$\",\"h3\",null,{\"className\":\"font-heading font-medium text-[19px] mb-2.5\",\"children\":\"Set the objective and the date\"}],[\"$\",\"p\",null,{\"className\":\"text-[14.5px] leading-[1.65] text-muted\",\"children\":\"What is launching, when it lands, and what the campaign is for — awareness, footfall, enquiries or sales.\"}]]}],[\"$\",\"div\",\"The sequence gets built\",{\"className\":\"border-t border-gold/30 pt-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-heading text-[22px] text-gold-text mb-3 tabular-nums\",\"children\":\"02\"}],[\"$\",\"h3\",null,{\"className\":\"font-heading font-medium text-[19px] mb-2.5\",\"children\":\"The sequence gets built\"}],[\"$\",\"p\",null,{\"className\":\"text-[14.5px] leading-[1.65] text-muted\",\"children\":\"A run of posts, carousels and reels that builds toward the date rather than repeating the same message.\"}]]}],[\"$\",\"div\",\"It runs and reports\",{\"className\":\"border-t border-gold/30 pt-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-heading text-[22px] text-gold-text mb-3 tabular-nums\",\"children\":\"03\"}],[\"$\",\"h3\",null,{\"className\":\"font-heading font-medium text-[19px] mb-2.5\",\"children\":\"It runs and reports\"}],[\"$\",\"p\",null,{\"className\":\"text-[14.5px] leading-[1.65] text-muted\",\"children\":\"The campaign publishes on schedule and reports as a unit, so you can see what the campaign did rather than what individual posts did.\"}]]}]]}]]}],[\"$\",\"hr\",null,{\"className\":\"border-t border-rule\"}],[\"$\",\"section\",null,{\"className\":\"px-6 md:px-12 lg:px-[120px] py-[100px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)] gap-x-[80px] gap-y-10\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"neb-label neb-label-gold mb-[20px] block\",\"children\":\"What you get\"}],[\"$\",\"h2\",null,{\"className\":\"font-heading font-medium text-[30px] md:text-[40px] leading-[1.14] tracking-[-0.02em]\",\"children\":[\"Concretely, \",[\"$\",\"span\",null,{\"className\":\"italic text-gold-text\",\"children\":\"this.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4\",\"children\":[[\"$\",\"div\",\"Campaigns as a unit of work, not a folder of posts\",{\"className\":\"flex items-start gap-3.5 border-b border-rule pb-4\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],