{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/channels/layout,_N_T_/channels/page,_N_T_/channels"}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Flogo-light.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-light.png&amp;w=384&amp;q=75 2x\" fetchPriority=\"high\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=384&amp;q=75 2x\" fetchPriority=\"high\"/><link rel=\"stylesheet\" href=\"/_next/static/css/91d486bf57bf1762.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-03f7c6bc932ce1e3.js\"/><script src=\"/_next/static/chunks/fd9d1056-b11b2651f33aae7f.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-4f5b424f20efdcae.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-6cdff17d3be181bf.js\" async=\"\"></script><script src=\"/_next/static/chunks/972-8c0ee6fabcd1342f.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/channels/page-590786a7526d9848.js\" async=\"\"></script><script src=\"/_next/static/chunks/309-526a3bc2ba734d25.js\" async=\"\"></script><script src=\"/_next/static/chunks/878-ed980f2cac33ad8c.js\" async=\"\"></script><script src=\"/_next/static/chunks/739-3ece649a7e02ff75.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-5a72189eaa6243d0.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>Channels — Where Nebulaa Publishes and Replies | Nebulaa.ai</title><meta name=\"description\" content=\"The channels we actually run: WhatsApp, Instagram, Facebook, LinkedIn, X, YouTube Shorts, email, SMS, voice, Google Business, Pinterest, paid media and quick commerce.\"/><meta name=\"keywords\" content=\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://nebulaa.ai\"/><meta property=\"og:title\" content=\"Channels — Where Nebulaa Publishes and Replies\"/><meta property=\"og:description\" content=\"The channels we actually run: WhatsApp, Instagram, Facebook, LinkedIn, X, YouTube Shorts, email, SMS, voice, Google Business, Pinterest, paid media and quick commerce.\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@nebulaaai\"/><meta name=\"twitter:title\" content=\"Nebulaa.ai — AI Marketing &amp; Outreach for Founders\"/><meta name=\"twitter:description\" content=\"Two AI agents. Your entire GTM. Automated.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&amp;family=Inter:wght@300;400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap\" rel=\"stylesheet\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"legalName\":\"Noburo Business Services LLP\",\"url\":\"https://nebulaa.ai\",\"email\":\"hello@nebulaa.ai\",\"description\":\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\",\"foundingDate\":\"2025\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressRegion\":\"Tamil Nadu\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"},\"makesOffer\":[{\"@type\":\"Offer\",\"name\":\"Gravity\",\"price\":\"10000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Gravity\",\"description\":\"Reads a website and builds a marketing strategy from it, plans the month, drafts posts, carousels and reels, tracks competitors, runs campaigns and creator collaborations, and handles the social inbox.\"}},{\"@type\":\"Offer\",\"name\":\"Pulsar\",\"price\":\"15000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Pulsar\",\"description\":\"Answers enquiries on WhatsApp, email and SMS within minutes, qualifies budget, timeline and fit, scores every lead, and runs broadcasts, automation and voice calling.\"}},{\"@type\":\"Offer\",\"name\":\"Both agents\",\"price\":\"20000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Both agents\",\"description\":\"Gravity and Pulsar on one account, sharing the same brand memory.\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"bg-ground text-ink font-body antialiased\"><nav class=\"fixed top-0 left-0 right-0 z-50 border-b border-rule transition-all duration-300 bg-ground/80 backdrop-blur-sm\" style=\"transform:translateY(-64px)\"><div class=\"flex items-center justify-between py-7 px-6 md:px-12 lg:px-[120px]\"><a class=\"flex-shrink-0\" href=\"/\"><img alt=\"Nebulaa.ai\" fetchPriority=\"high\" loading=\"eager\" width=\"160\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-10 w-auto hover:opacity-80 transition-opacity dark:hidden\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo-light.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-light.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo-light.png&amp;w=384&amp;q=75\"/><img alt=\"\" aria-hidden=\"true\" fetchPriority=\"high\" loading=\"eager\" width=\"160\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-10 w-auto hover:opacity-80 transition-opacity brightness-110 hidden dark:block\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=384&amp;q=75\"/></a><div class=\"hidden md:flex items-center gap-[38px]\"><div class=\"relative\"><button class=\"flex items-center gap-1 font-body text-sm text-muted hover:text-ink transition-colors\" aria-expanded=\"false\">Product<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><a class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\" href=\"/channels\">Channels<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><a class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\" href=\"/services\">Services<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><a href=\"/pricing\" class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\">Pricing<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><div class=\"relative\"><button class=\"flex items-center gap-1 font-body text-sm text-muted hover:text-ink transition-colors\" aria-expanded=\"false\">Resources<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div></div><div class=\"hidden md:flex items-center gap-3.5\"><a href=\"#\" class=\"font-body text-sm text-muted hover:text-ink transition-colors\">Sign in</a><a href=\"/pricing\" class=\"font-body text-sm font-semibold bg-brand-gold text-brand-black rounded-full px-[22px] py-[11px] shadow-[0_4px_18px_rgba(245,166,35,0.20)] hover:bg-brand-gold-dim transition-all\">Start free</a></div><div class=\"md:hidden flex items-center gap-2\"><button class=\"text-ink\" aria-label=\"Open menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></nav><main class=\"bg-ground text-ink min-h-screen\"><section class=\"px-6 md:px-12 lg:px-[120px] pt-[140px] pb-[90px] max-w-[860px]\"><span class=\"neb-label neb-label-gold mb-[26px] block\">Channels</span><h1 class=\"font-heading font-medium text-[40px] md:text-[60px] leading-[1.06] tracking-[-0.02em] mb-[26px]\" style=\"text-wrap:pretty\">Every channel we run.<!-- --> <span class=\"italic text-gold-display\">And who runs it.</span></h1><p class=\"text-[17.5px] leading-[1.65] text-muted max-w-[640px]\">Some of these the product publishes to on its own. Some need our team. The difference matters when you are deciding what to buy, so it is marked on every one rather than blurred together.</p></section><section class=\"px-6 md:px-12 lg:px-[120px] pb-[120px] flex flex-col gap-[72px]\"><div><div class=\"max-w-[640px] mb-8\"><h2 class=\"font-heading font-medium text-[26px] md:text-[32px] leading-[1.14] tracking-[-0.02em] mb-2.5\">Published by Gravity</h2><p class=\"text-[15px] leading-[1.65] text-muted\">The product plans and publishes to these directly, from one monthly content plan.</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-5\"><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/instagram\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">Instagram</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">Posts, carousels and reels planned a month ahead, published on schedule.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/facebook\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">Facebook</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">The same monthly plan, adapted for a Facebook audience.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/linkedin\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">LinkedIn</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">Founder-led B2B content, published consistently without you writing it.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/x\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">X</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">Short-form posts and threads from the same content plan.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/youtube-shorts\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">YouTube Shorts</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">The reels you already made, distributed where they get a second life.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></div></div><div><div class=\"max-w-[640px] mb-8\"><h2 class=\"font-heading font-medium text-[26px] md:text-[32px] leading-[1.14] tracking-[-0.02em] mb-2.5\">Handled by Pulsar</h2><p class=\"text-[15px] leading-[1.65] text-muted\">Conversation channels. Every enquiry answered, qualified and scored, in one thread per person.</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-5\"><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/whatsapp\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">WhatsApp</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">Where the enquiry actually arrives — answered in minutes, not Monday.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/email\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">Email</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">Handled in the same thread as WhatsApp, with the same qualification.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/sms\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">SMS</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">The channel that still gets read when nothing else does.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/voice\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">Voice calling</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">A managed call queue for the enquiries a message will not close.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></div></div><div><div class=\"max-w-[640px] mb-8\"><h2 class=\"font-heading font-medium text-[26px] md:text-[32px] leading-[1.14] tracking-[-0.02em] mb-2.5\">Run by our team</h2><p class=\"text-[15px] leading-[1.65] text-muted\">Part of a managed engagement rather than the self-serve product — these need a person, not just software.</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-5\"><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/google-business-profile\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">Google Business Profile</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">The listing that wins the &quot;near me&quot; search — kept current and answered.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/pinterest\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">Pinterest</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">Long-tail discovery for jewellery, textile, décor and food.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/meta-google-ads\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">Meta &amp; Google Ads</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">Always-on paid, geo-targeted to the markets and stores that matter.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/channels/quick-commerce\"><div class=\"flex items-baseline justify-between gap-3 mb-2.5\"><h3 class=\"font-heading font-medium text-[20px]\">Quick commerce</h3></div><p class=\"text-[13.5px] leading-[1.6] text-muted mb-5\">Driving discovery on Zepto, Blinkit and Instamart where you are listed.</p><span class=\"flex items-center gap-1.5 text-[13px] font-semibold text-gold-text group-hover:gap-2.5 transition-all\">Read <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></span></a></div></div></section></main><footer class=\"relative border-t border-rule pt-[60px] pb-[50px] px-6 md:px-12 lg:px-[120px]\"><div class=\"flex flex-col lg:flex-row items-start justify-between gap-[50px] lg:gap-[70px]\"><div><div class=\"flex items-center gap-[10px] mb-4\"><div class=\"w-[17px] h-[17px] rounded-full flex-shrink-0\" style=\"background:radial-gradient(circle at 34% 32%, #FFD48A 0%, #F5A623 46%, #A4650B 100%)\"></div><span class=\"font-heading text-[17px] font-normal text-ink\">Nebulaa</span></div><div class=\"font-body text-[13px] text-muted leading-[1.7]\">Chennai, India<br/><a href=\"mailto:hello@nebulaa.ai\" class=\"hover:text-gold-text transition-colors\">hello@nebulaa.ai</a></div></div><div class=\"flex flex-wrap gap-x-[70px] gap-y-[40px]\"><div class=\"flex flex-col gap-[11px]\"><span class=\"neb-label  mb-1\">Product</span><a href=\"/product\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Overview</a><a href=\"/product/gravity\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Gravity</a><a href=\"/product/pulsar\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Pulsar</a><a href=\"/pricing\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Pricing</a></div><div class=\"flex flex-col gap-[11px]\"><span class=\"neb-label  mb-1\">Services</span><a href=\"/services\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Managed services</a><a href=\"/channels\" class=\"font-body text-[13.5px] text-muted hover:text-ink transition-colors\">Channels</a><a href=