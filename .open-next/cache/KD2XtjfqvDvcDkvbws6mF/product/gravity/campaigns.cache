ound\",\"className\":\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"text-[15.5px] leading-[1.6] text-ink-2\",\"children\":\"Reporting per campaign, not just per post\"}]]}]]}]]}]}],[\"$\",\"hr\",null,{\"className\":\"border-t border-rule\"}],[\"$\",\"section\",null,{\"className\":\"px-6 md:px-12 lg:px-[120px] py-[100px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-[640px] mb-[44px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"neb-label neb-label-gold mb-[20px] block\",\"children\":\"Questions\"}],[\"$\",\"h2\",null,{\"className\":\"font-heading font-medium text-[30px] md:text-[42px] leading-[1.14] tracking-[-0.02em]\",\"children\":[\"The ones people \",[\"$\",\"span\",null,{\"className\":\"italic text-gold-text\",\"children\":\"actually ask.\"}]]}]]}],[\"$\",\"$L3\",null,{\"faqs\":[{\"q\":\"How is this different from just scheduling posts?\",\"a\":\"A campaign has an objective and a date, and the content is planned to build toward it. Scheduling is a queue; a campaign is a sequence.\"},{\"q\":\"Can I run more than one at once?\",\"a\":\"Yes — a festival campaign and a product launch can run in parallel, and the monthly plan accounts for both so your feed does not collide with itself.\"},{\"q\":\"Does it handle paid as well as organic?\",\"a\":\"Organic content is planned and published; individual posts can be boosted, and full paid campaign management is part of the managed service.\"}]}]]}],[\"$\",\"hr\",null,{\"className\":\"border-t border-rule\"}],[\"$\",\"section\",null,{\"className\":\"px-6 md:px-12 lg:px-[120px] py-[100px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"neb-label neb-label-gold mb-[26px] block\",\"children\":[\"Also in \",\"Gravity\"]}],[\"$\",\"div\",null,{\"className\":\"grid sm:grid-cols-3 gap-5\",\"children\":[[\"$\",\"$L2\",\"strategy-icp\",{\"hr