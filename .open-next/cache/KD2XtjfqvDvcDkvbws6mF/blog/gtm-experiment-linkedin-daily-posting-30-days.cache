,\\\"8\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Gravity posts. Pulsar calls. You close.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"property\\\":\\\"og:site_name\\\",\\\"content\\\":\\\"Nebulaa.ai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"en_IN\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"name\\\":\\\"twitter:site\\\",\\\"content\\\":\\\"@nebulaaai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Nebulaa.ai — AI Marketing \\u0026 Outreach for Founders\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Two AI agents. Your entire GTM. Automated.\\\"}],[\\\"$\\\",\\\"link\\\",\\\"17\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n3:null\\n\"])</script></body></html>","rsc":"3:I[4707,[],\"\"]\n5:I[6423,[],\"\"]\n7:I[2144,[\"972\",\"static/chunks/972-8c0ee6fabcd1342f.js\",\"309\",\"static/chunks/309-526a3bc2ba734d25.js\",\"878\",\"static/chunks/878-ed980f2cac33ad8c.js\",\"739\",\"static/chunks/739-3ece649a7e02ff75.js\",\"185\",\"static/chunks/app/layout-5a72189eaa6243d0.js\"],\"default\"]\n8:I[6194,[\"972\",\"static/chunks/972-8c0ee6fabcd1342f.js\",\"309\",\"static/chunks/309-526a3bc2ba734d25.js\",\"878\",\"static/chunks/878-ed980f2cac33ad8c.js\",\"739\",\"static/chunks/739-3ece649a7e02ff75.js\",\"185\",\"static/chunks/app/layout-5a72189eaa6243d0.js\"],\"default\"]\n4:[\"slug\",\"gtm-experiment-linkedin-daily-posting-30-days\",\"d\"]\n6:T5c5,{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"legalName\":\"Noburo Business Services LLP\",\"url\":\"https://nebulaa.ai\",\"email\":\"hello@nebulaa.ai\",\"description\":\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\",\"foundingDate\":\"2025\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressRegion\":\"Tamil Nadu\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"},\"makesOffer\":[{\"@type\":\"Offer\",\"name\":\"Gravity\",\"price\":\"10000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Gravity\",\"description\":\"Reads a website and builds a marketing strategy from it, plans the month, drafts posts, carousels and reels, tracks competitors, runs campaigns and creator collaborations, and handles the social inbox.\"}},{\"@type\":\"Offer\",\"name\":\"Pulsar\",\"price\":\"15000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Pulsar\",\"description\":\"Answers enquiries on WhatsApp, email and SMS within minutes, qualifies budget, timeline and fit, scores every lead, and runs broadcasts, automation and voice calling.\"}},{\"@type\":\"Offer\",\"name\":\"Both agents\",\"price\":\"20000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Both agents\",\"description\":\"Gravity and Pulsar on one account, sharing the same brand memory.\"}}]}0:[\"KD2XtjfqvDvcDkvbws6mF\",[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"gtm-experiment-linkedin-daily-posting-30-days\",\"d\"],{\"children\":[\"__PAGE__?{\\\"slug\\\":\\\"gtm-experiment-linkedin-daily-posting-30-days\\\"}\",{}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",{\"children\":[\"blog\",{\"children\":[[\"slug\",\"gtm-experiment-linkedin-daily-posting-30-days\",\"d\"],{\"children\":[\"__PAGE