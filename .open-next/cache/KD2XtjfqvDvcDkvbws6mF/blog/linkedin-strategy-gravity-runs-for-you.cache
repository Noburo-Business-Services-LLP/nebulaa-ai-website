me\\\":\\\"prose-nebulaa\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"title: \\\\\\\"The 7-Step LinkedIn Strategy That Gravity Runs For You\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"category: \\\\\\\"Marketing Automation\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"date: \\\\\\\"March 5, 2026\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"readTime: \\\\\\\"7 min read\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"author: \\\\\\\"Nebulaa Team\\\\\\\"\\\"}],[\\\"$\\\",\\\"div\\\",\\\"5\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h1\\\",\\\"6\\\",{\\\"className\\\":\\\"font-heading text-3xl font-bold text-brand-text dark:text-white mt-10 mb-4 tracking-tight\\\",\\\"children\\\":\\\"The 7-Step LinkedIn Strategy That Gravity Runs For You (That Would Take You 8 Hours/Week)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"7\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Most founders know they should be posting on LinkedIn. Almost none of them actually do it consistently. The reason isn't laziness — it's the invisible cost of the creative process.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"9\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Writing one post doesn't take 5 minutes. It takes 40. There's research, drafting, second-guessing, editing, formatting, scheduling. Do that three times a week and you've spent 2 hours you didn't have.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"11\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"Gravity solves this. Here's exactly how.\\\"}],[\\\"$\\\",\\\"div\\\",\\\"13\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"14\\\",{\\\"className\\\":\\\"font-heading text-2xl font-bold text-brand-text dark:text-white mt-8 mb-3 tracking-tight\\\",\\\"children\\\":\\\"Step 1: Brand Voice Ingestion (Done Once)\\\"}],[\\\"$\\\",\\\"div\\\",\\\"15\\\",{\\\"className\\\":\\\"my-3\\\"}],[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed my-3\\\",\\\"children\\\":\\\"The first thing Gravity does is read your website. Every page — home, about, product, blog. It extracts:\\\"}],[\\\"$\\\",\\\"div\\\",\\\"17\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"Your vocabulary and tone\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"18\\\",{\\\"className\\\":\\\"flex items-start gap-2 my-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-brand-gold mt-1 flex-shrink-0\\\",\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body text-base text-brand-text dark:text-white/80 leading-relaxed\\\",\\\"children\\\":\\\"The specific problems you solve\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\