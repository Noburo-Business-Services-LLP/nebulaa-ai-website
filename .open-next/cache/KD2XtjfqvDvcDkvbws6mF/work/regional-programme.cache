{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/work/layout,_N_T_/work/[engagement]/layout,_N_T_/work/[engagement]/page,_N_T_/work/regional-programme"}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Flogo-light.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-light.png&amp;w=384&amp;q=75 2x\" fetchPriority=\"high\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=384&amp;q=75 2x\" fetchPriority=\"high\"/><link rel=\"stylesheet\" href=\"/_next/static/css/91d486bf57bf1762.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-03f7c6bc932ce1e3.js\"/><script src=\"/_next/static/chunks/fd9d1056-b11b2651f33aae7f.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-4f5b424f20efdcae.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-6cdff17d3be181bf.js\" async=\"\"></script><script src=\"/_next/static/chunks/972-8c0ee6fabcd1342f.js\" async=\"\"></script><script src=\"/_next/static/chunks/309-526a3bc2ba734d25.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/work/%5Bengagement%5D/page-6116dd641e30b878.js\" async=\"\"></script><script src=\"/_next/static/chunks/878-ed980f2cac33ad8c.js\" async=\"\"></script><script src=\"/_next/static/chunks/739-3ece649a7e02ff75.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-5a72189eaa6243d0.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><title>Regional Marketing Programme — Organic, Paid &amp; BTL | Nebulaa | Nebulaa.ai</title><meta name=\"description\" content=\"Organic content, performance media and on-ground retail activation run as one system across multiple markets, reported together.\"/><meta name=\"keywords\" content=\"AI marketing automation India,AI outreach agent,GTM for startups,WhatsApp sales automation,AI sales agent SMB India\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://nebulaa.ai\"/><meta property=\"og:title\" content=\"Regional Marketing Programme — Organic, Paid &amp; BTL | Nebulaa\"/><meta property=\"og:description\" content=\"Organic content, performance media and on-ground retail activation run as one system across multiple markets, reported together.\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:site\" content=\"@nebulaaai\"/><meta name=\"twitter:title\" content=\"Nebulaa.ai — AI Marketing &amp; Outreach for Founders\"/><meta name=\"twitter:description\" content=\"Two AI agents. Your entire GTM. Automated.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&amp;family=Inter:wght@300;400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap\" rel=\"stylesheet\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"legalName\":\"Noburo Business Services LLP\",\"url\":\"https://nebulaa.ai\",\"email\":\"hello@nebulaa.ai\",\"description\":\"Nebulaa is a Chennai-based AI marketing company. It builds two agents — Gravity for marketing and Pulsar for outreach — and runs managed marketing engagements for brands across South India.\",\"foundingDate\":\"2025\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressRegion\":\"Tamil Nadu\",\"addressCountry\":\"IN\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"},\"makesOffer\":[{\"@type\":\"Offer\",\"name\":\"Gravity\",\"price\":\"10000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Gravity\",\"description\":\"Reads a website and builds a marketing strategy from it, plans the month, drafts posts, carousels and reels, tracks competitors, runs campaigns and creator collaborations, and handles the social inbox.\"}},{\"@type\":\"Offer\",\"name\":\"Pulsar\",\"price\":\"15000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Pulsar\",\"description\":\"Answers enquiries on WhatsApp, email and SMS within minutes, qualifies budget, timeline and fit, scores every lead, and runs broadcasts, automation and voice calling.\"}},{\"@type\":\"Offer\",\"name\":\"Both agents\",\"price\":\"20000\",\"priceCurrency\":\"INR\",\"itemOffered\":{\"@type\":\"SoftwareApplication\",\"name\":\"Both agents\",\"description\":\"Gravity and Pulsar on one account, sharing the same brand memory.\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"bg-ground text-ink font-body antialiased\"><nav class=\"fixed top-0 left-0 right-0 z-50 border-b border-rule transition-all duration-300 bg-ground/80 backdrop-blur-sm\" style=\"transform:translateY(-64px)\"><div class=\"flex items-center justify-between py-7 px-6 md:px-12 lg:px-[120px]\"><a class=\"flex-shrink-0\" href=\"/\"><img alt=\"Nebulaa.ai\" fetchPriority=\"high\" loading=\"eager\" width=\"160\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-10 w-auto hover:opacity-80 transition-opacity dark:hidden\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo-light.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-light.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo-light.png&amp;w=384&amp;q=75\"/><img alt=\"\" aria-hidden=\"true\" fetchPriority=\"high\" loading=\"eager\" width=\"160\" height=\"40\" decoding=\"async\" data-nimg=\"1\" class=\"h-10 w-auto hover:opacity-80 transition-opacity brightness-110 hidden dark:block\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=256&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=384&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo-dark.png&amp;w=384&amp;q=75\"/></a><div class=\"hidden md:flex items-center gap-[38px]\"><div class=\"relative\"><button class=\"flex items-center gap-1 font-body text-sm text-muted hover:text-ink transition-colors\" aria-expanded=\"false\">Product<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><a class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\" href=\"/channels\">Channels<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><a class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\" href=\"/services\">Services<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><a href=\"/pricing\" class=\"relative font-body text-sm text-muted hover:text-ink transition-colors group\">Pricing<span class=\"absolute -bottom-0.5 left-0 w-0 h-px bg-gold group-hover:w-full transition-all duration-300\"></span></a><div class=\"relative\"><button class=\"flex items-center gap-1 font-body text-sm text-muted hover:text-ink transition-colors\" aria-expanded=\"false\">Resources<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div></div><div class=\"hidden md:flex items-center gap-3.5\"><a href=\"#\" class=\"font-body text-sm text-muted hover:text-ink transition-colors\">Sign in</a><a href=\"/pricing\" class=\"font-body text-sm font-semibold bg-brand-gold text-brand-black rounded-full px-[22px] py-[11px] shadow-[0_4px_18px_rgba(245,166,35,0.20)] hover:bg-brand-gold-dim transition-all\">Start free</a></div><div class=\"md:hidden flex items-center gap-2\"><button class=\"text-ink\" aria-label=\"Open menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></nav><main class=\"bg-ground text-ink min-h-screen\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Engagements\",\"item\":\"https://nebulaa.ai/work\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Regional programme\",\"item\":\"https://nebulaa.ai/work/regional-programme\"}]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Regional programme\",\"description\":\"Organic content, performance media and on-ground retail activation run as one system across multiple markets, reported together.\",\"serviceType\":\"Marketing service\",\"url\":\"https://nebulaa.ai/work/regional-programme\",\"provider\":{\"@type\":\"Organization\",\"name\":\"Nebulaa\",\"url\":\"https://nebulaa.ai\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"India\"}}</script><section class=\"px-6 md:px-12 lg:px-[120px] pt-[130px] pb-[80px]\"><nav class=\"flex items-center gap-2 text-[12.5px] text-faint mb-8\"><a class=\"hover:text-gold-text\" href=\"/work\">Engagements</a><span>/</span><span class=\"text-muted\">Regional programme</span></nav><div class=\"max-w-[880px]\"><span class=\"neb-label neb-label-gold mb-[24px] block\">Engagement · regional</span><h1 class=\"font-heading font-medium text-[38px] md:text-[58px] leading-[1.08] tracking-[-0.02em] mb-[26px]\" style=\"text-wrap:pretty\">Three pillars,<!-- --> <span class=\"italic text-gold-display\">one execution system.</span></h1><p class=\"text-[17.5px] leading-[1.65] text-muted max-w-[640px] mb-7\">The largest shape we run. A brand present across several markets or a retail network, where organic content, paid media and on-ground activation all need to happen — and currently happen through different vendors who never speak to each other.</p><p class=\"text-[14px] text-faint mb-9\"><span class=\"uppercase tracking-[0.08em] text-muted\">Suited to</span> — <!-- -->Brands with distribution across several markets, regions or retail networks</p><a class=\"inline-flex items-center gap-2 bg-gold text-[#1A1208] text-[15px] font-semibold px-[28px] py-[14px] rounded-full hover:brightness-105 transition\" href=\"/services#contact\">Book a 20-min call <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></section><hr class=\"border-t border-rule\"/><section class=\"px-6 md:px-12 lg:px-[120px] py-[100px]\"><div class=\"max-w-[660px] mb-[52px]\"><span class=\"neb-label neb-label-gold mb-[20px] block\">What it includes</span><h2 class=\"font-heading font-medium text-[30px] md:text-[42px] leading-[1.14] tracking-[-0.02em] mb-4\">The scope, <span class=\"italic text-gold-text\">written down.</span></h2><p class=\"text-[16px] leading-[1.68] text-muted\">Agreed in writing before anything starts, so the retainer cannot quietly shrink over time.</p></div><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7\"><h3 class=\"font-heading font-medium text-[19px] mb-5 pb-3.5 border-b border-gold/30\">Pillar one — organic</h3><div class=\"flex flex-col gap-3.5\"><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Dedicated regional pages or market-specific content where it makes sense</span></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Daily content tuned to each market, in local language where relevant</span></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Product education, real usage, testimonials, promotions and festival content</span></div></div></div><div class=\"bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7\"><h3 class=\"font-heading font-medium text-[19px] mb-5 pb-3.5 border-b border-gold/30\">Pillar two — performance</h3><div class=\"flex flex-col gap-3.5\"><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Always-on Meta campaigns — awareness, engagement, retargeting</span></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Google search and demand generation with regional targeting</span></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Micro and nano regional creators chosen for local credibility</span></div></div></div><div class=\"bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7\"><h3 class=\"font-heading font-medium text-[19px] mb-5 pb-3.5 border-b border-gold/30\">Pillar three — BTL and retail</h3><div class=\"flex flex-col gap-3.5\"><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Festival and seasonal activation across regional occasions</span></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Product launches, dealer events and retail activations</span></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Geo-targeted spend concentrated around priority retail clusters</span></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[14px] leading-[1.6] text-ink-2\">Dealer-specific communication and point-of-sale support</span></div></div></div></div></section><hr class=\"border-t border-rule\"/><section class=\"px-6 md:px-12 lg:px-[120px] py-[100px]\"><div class=\"max-w-[640px] mb-[46px]\"><span class=\"neb-label neb-label-gold mb-[20px] block\">How it runs</span><h2 class=\"font-heading font-medium text-[30px] md:text-[42px] leading-[1.14] tracking-[-0.02em]\">The rhythm of it.</h2></div><div class=\"flex flex-col gap-px bg-rule border border-rule rounded-[18px] overflow-hidden\"><div class=\"bg-surface grid md:grid-cols-[150px_minmax(0,1fr)] gap-x-8 gap-y-2 px-6 md:px-9 py-6\"><div class=\"neb-label neb-label-gold pt-1\">Phase 1</div><p class=\"text-[15px] leading-[1.65] text-muted\">Understand objectives, set market priorities, agree the content calendar, begin organic and digital promotion.</p></div><div class=\"bg-surface grid md:grid-cols-[150px_minmax(0,1fr)] gap-x-8 gap-y-2 px-6 md:px-9 py-6\"><div class=\"neb-label neb-label-gold pt-1\">Phase 2</div><p class=\"text-[15px] leading-[1.65] text-muted\">Manage paid and creator campaigns, execute BTL where scheduled, optimise in real time.</p></div><div class=\"bg-surface grid md:grid-cols-[150px_minmax(0,1fr)] gap-x-8 gap-y-2 px-6 md:px-9 py-6\"><div class=\"neb-label neb-label-gold pt-1\">Continuous</div><p class=\"text-[15px] leading-[1.65] text-muted\">Monitor, learn, optimise, execute again — with every layer tracked on its own terms.</p></div></div></section><hr class=\"border-t border-rule\"/><section class=\"px-6 md:px-12 lg:px-[120px] py-[100px]\"><div class=\"grid lg:grid-cols-[minmax(0,400px)_minmax(0,1fr)] gap-x-[80px] gap-y-10\"><div><span class=\"neb-label neb-label-gold mb-[20px] block\">What changes</span><h2 class=\"font-heading font-medium text-[30px] md:text-[40px] leading-[1.14] tracking-[-0.02em] mb-4\">Described honestly, <span class=\"italic text-gold-text\">not as a stat.</span></h2><p class=\"text-[15px] leading-[1.65] text-muted\">We are not putting numbers on this page until there is published client work we can point at. What follows is what the engagement is for.</p></div><div class=\"flex flex-col gap-4\"><div class=\"flex items-start gap-3.5 border-b border-rule pb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[15.5px] leading-[1.6] text-ink-2\">Consumer communication connects to where the product is actually sold</span></div><div class=\"flex items-start gap-3.5 border-b border-rule pb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[15.5px] leading-[1.6] text-ink-2\">Each market gets content adapted to it rather than a national message</span></div><div class=\"flex items-start gap-3.5 border-b border-rule pb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[15.5px] leading-[1.6] text-ink-2\">Dealer and retail activity stops being disconnected from brand marketing</span></div><div class=\"flex items-start gap-3.5 border-b border-rule pb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check text-gold-text flex-shrink-0 mt-[3px]\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-[15.5px] leading-[1.6] text-ink-2\">Reporting arrives as one picture instead of three vendors&#x27; separate claims</span></div></div></div></section><hr class=\"border-t border-rule\"/><section class=\"px-6 md:px-12 lg:px-[120px] py-[100px]\"><div class=\"max-w-[640px] mb-[44px]\"><span class=\"neb-label neb-label-gold mb-[20px] block\">Questions</span><h2 class=\"font-heading font-medium text-[30px] md:text-[42px] leading-[1.14] tracking-[-0.02em]\">Before you ask <span class=\"italic text-gold-text\">on the call.</span></h2></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How many markets can this cover?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It scales by market. The model is the same whether it is three cities or a retail network across a state — the team and the cost scale with it.\"}},{\"@type\":\"Question\",\"name\":\"Do you work with our existing agencies?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We can, though the reason this works is that the three pillars run together. Splitting them across vendors is usually the problem being solved.\"}},{\"@type\":\"Question\",\"name\":\"How is BTL measured?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Participation, samples distributed, dealer engagement, and movement in the geo-targeted campaigns running around the same clusters. It is not as clean as a click and we say so.\"}}]}</script><div class=\"max-w-[820px]\"><div class=\"border-b border-rule transition-all duration-200 pl-0\"><button aria-expanded=\"false\" class=\"w-full flex items-center justify-between py-5 text-left cursor-pointer group gap-4\"><span class=\"font-heading text-[18px] font-medium text-ink group-hover:text-gold-text transition-colors\">How many markets can this cover?</span><div class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down text-gold-text\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button></div><div class=\"border-b border-rule transition-all duration-200 pl-0\"><button aria-expanded=\"false\" class=\"w-full flex items-center justify-between py-5 text-left cursor-pointer group gap-4\"><span class=\"font-heading text-[18px] font-medium text-ink group-hover:text-gold-text transition-colors\">Do you work with our existing agencies?</span><div class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down text-gold-text\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button></div><div class=\"border-b border-rule transition-all duration-200 pl-0\"><button aria-expanded=\"false\" class=\"w-full flex items-center justify-between py-5 text-left cursor-pointer group gap-4\"><span class=\"font-heading text-[18px] font-medium text-ink group-hover:text-gold-text transition-colors\">How is BTL measured?</span><div class=\"flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down text-gold-text\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></div></button></div></div></section><hr class=\"border-t border-rule\"/><section class=\"px-6 md:px-12 lg:px-[120px] py-[100px]\"><span class=\"neb-label neb-label-gold mb-[26px] block\">The other shapes</span><div class=\"grid sm:grid-cols-2 gap-5\"><a class=\"group block bg-surface border border-rule rounded-[18px] px-[28px] pt-[28px] pb-7 hover:border-gold/30 transition-colors\" href=\"/work/always-on-content\"><h